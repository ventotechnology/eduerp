# EduERP Environment Configuration Example
# Copy this file to .env or /etc/eduerp/eduerp.env

NODE_ENV=production
PORT=3005

# Database Configuration (PostgreSQL for Production, SQLite for Local Dev)
# Production: postgresql://eduerp_app:PASSWORD@localhost:5432/eduerp_prod?schema=public
# Development: file:./dev.db
DATABASE_URL=postgresql://eduerp_app:your_strong_db_password_here@localhost:5432/eduerp_prod?schema=public

# Application URLs
APP_URL=https://eduerp.us
NEXT_PUBLIC_APP_URL=https://eduerp.us
NEXT_PUBLIC_APP_DOMAIN=eduerp.us
NEXT_PUBLIC_ROOT_DOMAIN=eduerp.us

# Authentication & Session Security (Generate with: openssl rand -base64 48)
AUTH_SECRET=generate_strong_random_secret_32_bytes_or_more
SESSION_SECRET=generate_strong_random_secret_32_bytes_or_more
SESSION_EXPIRY_DAYS=7

# Feature Toggles
ENABLE_DEMO_SIMULATORS=false
