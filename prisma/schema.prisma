datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. SaaS Platform, Multi-Tenancy & Domains
// ----------------------------------------------------

enum InstitutionType {
  SCHOOL
  COLLEGE
  SCHOOL_AND_COLLEGE
  MADRASHA
  UNIVERSITY
  POLYTECHNIC
  TECHNICAL_INSTITUTE
  TRAINING_INSTITUTE
  OTHER
}

enum SubscriptionTier {
  STARTER
  STANDARD
  PROFESSIONAL
  ENTERPRISE
}

model Tenant {
  id               String           @id @default(uuid())
  slug             String           @unique // e.g. "dhaka-ideal-school"
  customDomain     String?          @unique // e.g. "erp.dims.edu.bd"
  institutionType  InstitutionType  @default(SCHOOL)
  subscriptionTier SubscriptionTier @default(PROFESSIONAL)
  isActive         Boolean          @default(true)
  isDemoTenant     Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Multi-domain mapping
  domains              TenantDomain[]
  institution          Institution?
  users                User[]
  auditLogs            AuditLog[]
  subscriptions        Subscription[]
  usageRecords         UsageRecord[]
  subscriptionOrders   SubscriptionOrder[]
  subscriptionInvoices SubscriptionInvoice[]

  @@index([slug])
  @@index([isActive])
}

model TenantDomain {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain     String    @unique // e.g. "portal.dims.edu.bd" or "dims.eduerp.us"
  isPrimary  Boolean   @default(false)
  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model SubscriptionPlan {
  id          String           @id @default(uuid())
  code        String           @unique // "STARTER", "STANDARD", "PROFESSIONAL", "ENTERPRISE"
  tier        SubscriptionTier @default(STARTER)
  name        String // "Starter", "Standard", "Professional", "Enterprise"
  slug        String           @unique // "starter", "standard", "professional", "enterprise"
  description String

  monthlyPrice Float  @default(0)
  annualPrice  Float  @default(0)
  currency     String @default("BDT")

  monthlyDiscount Float @default(0)
  annualDiscount  Float @default(0)
  trialDays       Int   @default(14)
  setupFee        Float @default(0)

  maxStudents    Int @default(500)
  maxCampuses    Int @default(1)
  maxUsers       Int @default(50)
  maxTeachers    Int @default(50)
  maxStorageGb   Int @default(20)
  includedSms    Int @default(1000)
  includedEmails Int @default(5000)

  apiAccess       Boolean @default(false)
  customDomain    Boolean @default(false)
  whiteLabel      Boolean @default(false)
  prioritySupport Boolean @default(false)

  isPublic     Boolean @default(true)
  isActive     Boolean @default(true)
  isFeatured   Boolean @default(false)
  displayOrder Int     @default(0)
  badge        String?
  buttonText   String  @default("Choose Plan")

  priceMonthlyBdt Float @default(0)
  priceMonthlyUsd Float @default(0)

  features      PlanFeature[]
  subscriptions Subscription[]
  orders        SubscriptionOrder[]
  invoices      SubscriptionInvoice[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model PlanFeature {
  id          String           @id @default(uuid())
  planId      String
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey  String // "ADMISSION", "SIS", "ATTENDANCE", "ACADEMICS", "EXAMINATION", "FINANCE", "HR", "LMS", "REPORTING", "REGULATORY", "API", "WHITE_LABEL", "CUSTOM_DOMAIN"
  name        String?
  description String?
  isEnabled   Boolean          @default(true)
  limitValue  Int?

  @@unique([planId, featureKey])
}

model Subscription {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  billingCycle       String           @default("MONTHLY") // "MONTHLY" | "ANNUAL"
  startDate          DateTime
  endDate            DateTime
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime?
  status             String           @default("ACTIVE") // TRIALING, PENDING_PAYMENT, ACTIVE, PAST_DUE, SUSPENDED, CANCELLED, EXPIRED
  autoRenew          Boolean          @default(true)
  cancelAtPeriodEnd  Boolean          @default(false)
  trialEndsAt        DateTime?
  lastBilledAt       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([tenantId, status])
}

model SignupApplication {
  id              String              @id @default(uuid())
  institutionName String
  institutionType InstitutionType     @default(SCHOOL)
  contactPerson   String
  email           String
  phone           String
  country         String              @default("Bangladesh")
  address         String
  desiredSlug     String              @unique
  passwordHash    String
  planId          String
  billingCycle    String              @default("MONTHLY") // "MONTHLY" | "ANNUAL"
  amount          Float
  currency        String              @default("BDT")
  checkoutToken   String              @unique @default(uuid())
  status          String              @default("PENDING_PAYMENT") // DRAFT, PENDING_PAYMENT, PAYMENT_PROCESSING, PAID, PROVISIONING, ACTIVE, FAILED, CANCELLED, EXPIRED
  tenantId        String?
  orders          SubscriptionOrder[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  expiresAt       DateTime

  @@index([email])
  @@index([desiredSlug])
  @@index([status])
}

model SubscriptionOrder {
  id           String             @id @default(uuid())
  orderNumber  String             @unique // e.g. "EDU-ORD-2026-XXXXX"
  signupId     String?
  signup       SignupApplication? @relation(fields: [signupId], references: [id], onDelete: SetNull)
  tenantId     String?
  tenant       Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  planId       String
  plan         SubscriptionPlan   @relation(fields: [planId], references: [id])
  billingCycle String             @default("MONTHLY") // "MONTHLY" | "ANNUAL"
  subtotal     Float
  discount     Float              @default(0)
  promoCode    String?
  setupFee     Float              @default(0)
  taxRate      Float              @default(0)
  taxAmount    Float              @default(0)
  totalAmount  Float
  currency     String             @default("BDT")
  status       String             @default("PENDING") // PENDING, PROCESSING, PAID, FULFILLED, CANCELLED, FAILED, EXPIRED
  gateway      String? // "BKASH", "NAGAD", "ROCKET", "CARD", "BANK_TRANSFER"
  paymentId    String?            @unique
  trxId        String?            @unique
  paidAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  expiresAt    DateTime

  payments SubscriptionPaymentTransaction[]
  invoices SubscriptionInvoice[]

  @@index([orderNumber])
  @@index([status])
  @@index([signupId])
  @@index([tenantId])
}

model SubscriptionInvoice {
  id             String             @id @default(uuid())
  invoiceNumber  String             @unique // e.g. "EDU-INV-2026-XXXXX"
  orderId        String?
  order          SubscriptionOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  tenantId       String?
  tenant         Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  planId         String
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id])
  billingPeriod  String // "2026-08-24 to 2027-08-24"
  billingCycle   String             @default("MONTHLY")
  subTotal       Float
  discountAmount Float              @default(0)
  taxAmount      Float              @default(0)
  totalAmount    Float
  currency       String             @default("BDT")
  status         String             @default("PAID") // UNPAID, PAID, VOID, REFUNDED
  paidAt         DateTime?          @default(now())
  paymentMethod  String? // "BKASH", "NAGAD", "CARD", "BANK_TRANSFER"
  transactionRef String?
  receiptUrl     String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([tenantId])
  @@index([invoiceNumber])
  @@index([status])
}

model SubscriptionPaymentTransaction {
  id                  String            @id @default(uuid())
  orderId             String
  order               SubscriptionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway             String // "BKASH", "NAGAD", "ROCKET", "CARD", "BANK_TRANSFER"
  paymentId           String? // Gateway payment ID (e.g. bKash paymentID)
  trxId               String? // Gateway transaction reference (e.g. bKash trxID)
  amount              Float
  currency            String            @default("BDT")
  status              String            @default("INITIATED") // INITIATED, SUCCESS, FAILED, CANCELLED
  initiatedAt         DateTime          @default(now())
  executedAt          DateTime?
  verifiedAt          DateTime?
  providerResponseRef String?
  errorMessage        String?
  createdAt           DateTime          @default(now())

  @@index([orderId])
  @@index([paymentId])
  @@index([trxId])
  @@index([status])
}

model PaymentGatewayConfig {
  id           String   @id @default(uuid())
  gateway      String   @unique // "BKASH", "NAGAD", "ROCKET", "CARD", "BANK_TRANSFER"
  name         String
  displayName  String
  provider     String?
  isEnabled    Boolean  @default(false)
  isSandbox    Boolean  @default(true)
  displayOrder Int      @default(0)
  minAmount    Float    @default(1)
  maxAmount    Float    @default(500000)
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([gateway])
  @@index([isEnabled])
}

model PlatformBillingSettings {
  id                       String   @id @default("default")
  taxEnabled               Boolean  @default(false)
  taxName                  String   @default("VAT")
  taxRate                  Float    @default(0)
  taxRegistrationReference String?
  taxInclusive             Boolean  @default(true)
  gracePeriodDays          Int      @default(3)
  currency                 String   @default("BDT")
  updatedAt                DateTime @updatedAt
}

model PromoCode {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?
  discountType   String    @default("PERCENTAGE") // "PERCENTAGE" | "FIXED"
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  applicableTier String? // STARTER, STANDARD, PROFESSIONAL, ENTERPRISE or null for all
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model UsageRecord {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metric     String // "SMS_SENT", "STORAGE_BYTES", "ACTIVE_STUDENTS"
  quantity   Float
  recordedAt DateTime @default(now())

  @@index([tenantId, metric])
}

// ----------------------------------------------------
// 2. Institution Profile & Campus Management
// ----------------------------------------------------

model Institution {
  id                String  @id @default(uuid())
  tenantId          String  @unique
  tenant            Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  shortName         String
  eiin              String?
  instituteCode     String?
  mpoStatus         Boolean @default(false)
  universityCode    String?
  boardAffiliation  String?
  madrashaBoardInfo String?
  ugcInfo           String?
  ministryInfo      String?

  // Contact & Location
  address            String
  district           String
  division           String
  upazilaThana       String
  phone              String
  email              String
  website            String?
  establishmentYear  Int?
  principalHeadName  String?
  principalHeadTitle String?

  // Branding & Currency
  logoUrl           String?
  sealUrl           String?
  signatureUrl      String?
  primaryColor      String    @default("#2563eb")
  secondaryColor    String    @default("#0f172a")
  currencyCode      String    @default("BDT")
  currencySymbol    String    @default("৳")
  currencyPrecision Int       @default(2)
  financialLockDate DateTime?

  // Relationships
  campuses                  Campus[]
  academicYears             AcademicYear[]
  shifts                    Shift[]
  academicGroups            AcademicGroup[]
  subjectCombinations       SubjectCombinationTemplate[]
  curriculums               Curriculum[]
  technologyTrades          TechnologyTrade[]
  periods                   Period[]
  buildings                 Building[]
  calendarEvents            AcademicCalendarEvent[]
  timetableEntries          TimetableEntry[]
  faculties                 Faculty[]
  departments               Department[]
  classes                   Class[]
  feeStructures             FeeStructure[]
  gradingScales             GradingScale[]
  certificates              Certificate[]
  customFields              CustomField[]
  notices                   Notice[]
  events                    Event[]
  accounts                  ChartOfAccount[]
  journalEntries            JournalEntry[]
  fiscalYears               FiscalYear[]
  fiscalPeriods             FiscalPeriod[]
  costCenters               CostCenter[]
  funds                     Fund[]
  accountMappings           AccountMapping[]
  feeTypes                  FeeType[]
  lateFeeRules              LateFeeRule[]
  scholarships              ScholarshipMaster[]
  scholarshipApplications   ScholarshipApplication[]
  scholarshipAwards         ScholarshipAward[]
  feeWaivers                FeeWaiver[]
  studentCreditBalances     StudentCreditBalance[]
  refundRequests            RefundRequest[]
  bankAccounts              InstitutionBankAccount[]
  cheques                   ChequeRecord[]
  bankReconciliations       BankReconciliation[]
  vendors                   Vendor[]
  vendorBills               VendorBill[]
  expenseRequests           ExpenseRequest[]
  budgets                   Budget[]
  salaryStructures          SalaryStructure[]
  payrollPeriods            PayrollPeriod[]
  employeeLoans             EmployeeLoan[]
  salaryAdvances            SalaryAdvance[]
  researchProjects          ResearchProject[]
  assets                    AssetRecord[]
  admissionApplications     AdmissionApplication[]
  admissionTests            AdmissionTest[]
  exams                     Exam[]
  assessmentComponents      AssessmentComponent[]
  markDistributionTemplates MarkDistributionTemplate[]
  officialTranscripts       OfficialTranscript[]
  promotionBatches          PromotionBatch[]
  graduationRecords         GraduationRecord[]

  // HR, Workforce & Recruitment (Command 6)
  positions                Position[]
  jobRequisitions          JobRequisition[]
  jobVacancies             JobVacancy[]
  jobCandidates            JobCandidate[]
  jobOffers                JobOffer[]
  hrShifts                 HrShift[]
  employeeRawPunches       EmployeeRawPunch[]
  employeeDailyAttendances EmployeeDailyAttendance[]
  hrLeaveTypes             HrLeaveType[]
  hrLeavePolicies          HrLeavePolicy[]
  performanceCycles        PerformanceCycle[]
  trainingPrograms         TrainingProgram[]
  disciplinaryCases        EmployeeDisciplinaryCase[]
  grievances               EmployeeGrievance[]
  separations              EmployeeSeparation[]

  // Facilities, Operations & Logistics (Command 7)
  facilities               Facility[]
  libraries                Library[]
  libraryCatalogs          LibraryCatalog[]
  libraryBorrowingPolicies LibraryBorrowingPolicy[]
  libraryMembers           LibraryMember[]
  bookIssues               BookIssue[]
  bookReservations         BookReservation[]
  libraryStocktakes        LibraryStocktake[]
  hostelMasters            HostelMaster[]
  hostelApplications       HostelApplication[]
  hostelAllocations        HostelAllocation[]
  hostelVisitorLogs        HostelVisitorLog[]
  transportVehicles        TransportVehicle[]
  transportRoutes          TransportRoute[]
  transportSubscriptions   TransportSubscription[]
  tripSchedules            TripSchedule[]
  transportIncidents       TransportIncident[]
  fuelLogs                 FuelLog[]
  vehicleMaintenances      VehicleMaintenanceRecord[]
  canteens                 Canteen[]
  canteenItems             CanteenItem[]
  canteenWallets           CanteenWallet[]
  canteenPosSales          CanteenPosSale[]
  inventoryCategories      InventoryCategory[]
  warehouses               Warehouse[]
  inventoryItems           InventoryItem[]
  stockLedgers             StockLedger[]
  stockTransfers           StockTransfer[]
  stockIssueRecords        StockIssueRecord[]
  fixedAssets              FixedAsset[]
  purchaseRequisitions     PurchaseRequisition[]
  rfqs                     RequestForQuotation[]
  vendorQuotations         VendorQuotation[]
  purchaseOrders           PurchaseOrder[]
  goodsReceiptNotes        GoodsReceiptNote[]
  maintenanceRequests      MaintenanceRequest[]
  visitorRecords           VisitorRecord[]
  studentPickupAuths       StudentPickupAuthorization[]
  vehicleGateLogs          VehicleGateLog[]
  facilityBookings         FacilityBooking[]
  lmsCourses               LmsCourse[]
  lmsRubrics               LmsRubric[]
  lmsQuestionBanks         LmsQuestionBank[]
  lmsLearningActivityLogs  LmsLearningActivityLog[]

  // Reporting, Custom Builder & Regulatory Compliance (Command 9)
  reportDefinitions    ReportDefinition[]
  reportExecutions     ReportExecution[]
  reportSnapshots      ReportSnapshot[]
  reportExports        ReportExport[]
  dashboardDefinitions DashboardDefinition[]
  reportSchedules      ReportSchedule[]
  regulatoryReportRuns RegulatoryReportRun[]
  dataQualityRules     DataQualityRule[]
  dataQualityIssues    DataQualityIssue[]

  @@index([tenantId])
}

model Campus {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  code          String
  type          String      @default("Main Campus") // Main, Branch, Boys, Girls, University
  address       String
  phone         String?
  email         String?
  isMain        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  students              Student[]
  employees             Employee[]
  classrooms            Classroom[]
  buildings             Building[]
  hostels               Hostel[]
  vehicles              Vehicle[]
  books                 Book[]
  admissionApplications AdmissionApplication[]
  attendanceSessions    AttendanceSession[]
  timetableEntries      TimetableEntry[]
  positions             Position[]
  jobVacancies          JobVacancy[]

  // Command 7 Facilities
  facilities          Facility[]
  libraries           Library[]
  hostelMasters       HostelMaster[]
  transportVehicles   TransportVehicle[]
  transportRoutes     TransportRoute[]
  canteens            Canteen[]
  warehouses          Warehouse[]
  fixedAssets         FixedAsset[]
  maintenanceRequests MaintenanceRequest[]
  visitorRecords      VisitorRecord[]
  vehicleGateLogs     VehicleGateLog[]
  facilityBookings    FacilityBooking[]
  lmsCourses          LmsCourse[]
  reportDefinitions   ReportDefinition[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

// ----------------------------------------------------
// 3. Authentication, Identity & RBAC
// ----------------------------------------------------

enum UserRole {
  // Platform Super Admin Roles
  PLATFORM_SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_ADMIN
  BILLING_ADMIN
  SALES_ADMIN
  SUPER_ADMIN // Alias

  // Institution Leadership Roles
  OWNER
  CHAIRMAN
  TRUSTEE
  VICE_CHANCELLOR
  PRO_VICE_CHANCELLOR
  REGISTRAR
  PRINCIPAL
  VICE_PRINCIPAL
  DEAN
  HEAD_OF_DEPARTMENT
  COORDINATOR

  // Teaching & Academic Roles
  TEACHER
  FACULTY

  // Operational & Administrative Roles
  ACCOUNTANT
  HR_MANAGER
  LIBRARIAN
  HOSTEL_MANAGER
  TRANSPORT_MANAGER
  ADMISSION_OFFICER

  // Stakeholder Roles
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
  PENDING_VERIFICATION
}

model User {
  id                  String     @id @default(uuid())
  tenantId            String? // NULL for Global Platform Super Admins
  tenant              Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email               String     @unique
  passwordHash        String
  name                String
  phone               String?
  role                UserRole   @default(STUDENT)
  status              UserStatus @default(ACTIVE)
  avatarUrl           String?
  isMfaEnabled        Boolean    @default(false)
  mfaSecret           String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  sessions UserSession[]
  student  Student?
  guardian Guardian?
  employee Employee?

  @@index([tenantId, role])
  @@index([email])
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

// ----------------------------------------------------
// 4. Academic Structure (Universal Core + Verticals)
// ----------------------------------------------------

model AcademicYear {
  id                 String      @id @default(uuid())
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name               String // "2026", "2026-2027"
  code               String? // "AY-2026"
  startDate          DateTime
  endDate            DateTime
  admissionStartDate DateTime?
  admissionEndDate   DateTime?
  classStartDate     DateTime?
  status             String      @default("ACTIVE") // DRAFT, UPCOMING, ACTIVE, CLOSED, ARCHIVED
  isCurrent          Boolean     @default(false)

  sessions              Session[]
  admissionApplications AdmissionApplication[]
  teacherAssignments    TeacherAssignment[]
  timetableEntries      TimetableEntry[]
  enrollments           Enrollment[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Session {
  id                    String       @id @default(uuid())
  academicYearId        String
  academicYear          AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name                  String // "Spring 2026", "Annual Term 2026", "Trimester 1"
  type                  String // SEMESTER, TRIMESTER, TERM, ANNUAL
  startDate             DateTime
  endDate               DateTime
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  addDropDeadline       DateTime?
  examStartDate         DateTime?
  examEndDate           DateTime?
  resultPublishDate     DateTime?
  status                String       @default("ACTIVE") // DRAFT, UPCOMING, ACTIVE, CLOSED, ARCHIVED
  isCurrent             Boolean      @default(false)

  enrollments        Enrollment[]
  exams              Exam[]
  courseOfferings    CourseOffering[]
  timetableEntries   TimetableEntry[]
  studentSubjectRegs StudentSubjectRegistration[]

  @@index([academicYearId])
}

model Shift {
  id              String      @id @default(uuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name            String // Morning, Day, Evening, Custom
  code            String // SFT-01
  startTime       String // "07:30"
  endTime         String // "12:30"
  breakStartTime  String? // "10:00"
  breakEndTime    String? // "10:30"
  applicableLevel String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())

  periods Period[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model AcademicGroup {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String // Science, Business Studies, Humanities, General, Vocational
  code          String // SCI, BIZ, HUM, GEN
  description   String?
  createdAt     DateTime    @default(now())

  combinations SubjectCombinationTemplate[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model SubjectCombinationTemplate {
  id                     String        @id @default(uuid())
  institutionId          String
  institution            Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  groupId                String
  group                  AcademicGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name                   String // "HSC Science - Higher Math & Biology"
  code                   String // COMB-SCI-01
  compulsorySubjectCodes String // JSON array of subject codes / IDs
  electiveSubjectCodes   String // JSON array
  fourthSubjectChoices   String // JSON array
  practicalSubjectCodes  String? // JSON array
  createdAt              DateTime      @default(now())

  @@unique([institutionId, code])
  @@index([institutionId])
}

model StudentSubjectRegistration {
  id              String   @id @default(uuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  isFourthSubject Boolean  @default(false)
  isElective      Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([studentId, sessionId, subjectId])
  @@index([studentId])
}

// University Hierarchies
model Faculty {
  id            String       @id @default(uuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String // Faculty of Engineering, Faculty of Business
  code          String
  deanName      String?
  departments   Department[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Department {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  facultyId     String?
  faculty       Faculty?    @relation(fields: [facultyId], references: [id])
  name          String // CSE, EEE, BBA, Al-Hadith
  code          String
  headName      String?

  programs     Program[]
  teachers     Teacher[]
  employees    Employee[]
  positions    Position[]
  jobVacancies JobVacancy[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Program {
  id            String     @id @default(uuid())
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name          String // BSc in CSE, HSC Science, Dakhil
  code          String
  degreeLevel   String // BACHELOR, MASTER, HSC, SSC, DAKHIL
  durationYears Float      @default(4.0)
  totalCredits  Float?

  courses               Course[]
  batches               Batch[]
  curriculums           Curriculum[]
  admissionApplications AdmissionApplication[]
  graduationRecords     GraduationRecord[]
  targetExams           Exam[]

  @@index([departmentId])
}

model Batch {
  id        String    @id @default(uuid())
  programId String
  program   Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String // "Batch 2026", "HSC 2026"
  year      Int
  students  Student[]

  @@index([programId])
}

model Curriculum {
  id            String              @id @default(uuid())
  institutionId String
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programId     String
  program       Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  name          String // "BSc in CSE OBE Curriculum"
  code          String // CURR-CSE-2026
  versions      CurriculumVersion[]

  @@unique([institutionId, code])
  @@index([programId])
}

model CurriculumVersion {
  id                 String     @id @default(uuid())
  curriculumId       String
  curriculum         Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  versionCode        String // "2026-V1.0", "2028-V2.0"
  effectiveSessionId String?
  totalCredits       Float      @default(144.0)
  minCgpa            Float      @default(2.00)
  status             String     @default("ACTIVE") // ACTIVE, DRAFT, DEPRECATED
  createdAt          DateTime   @default(now())

  courses CurriculumCourse[]

  @@unique([curriculumId, versionCode])
  @@index([curriculumId])
}

model CurriculumCourse {
  id                  String            @id @default(uuid())
  curriculumVersionId String
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterNumber      Int               @default(1) // 1..8
  isRequired          Boolean           @default(true)
  minGradePoint       Float             @default(2.00)

  @@unique([curriculumVersionId, courseId])
  @@index([curriculumVersionId])
}

// School & College Hierarchies
model Class {
  id                   String      @id @default(uuid())
  institutionId        String
  institution          Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name                 String // Play, Nursery, Grade 1..12, XI, XII, Ebtedayee 1
  numericValue         Int
  sequence             Int         @default(1)
  stage                String? // PRIMARY, SECONDARY, HIGHER_SECONDARY, DAKHIL
  promotionTargetClass String?
  shift                String      @default("Morning") // Morning, Day

  sections              Section[]
  subjects              Subject[]
  admissionApplications AdmissionApplication[]
  attendanceSessions    AttendanceSession[]
  teacherAssignments    TeacherAssignment[]
  examSchedules         ExamSchedule[]
  targetExams           Exam[]
  enrollments           Enrollment[]

  @@unique([institutionId, name, shift])
  @@index([institutionId])
}

model Section {
  id         String  @id @default(uuid())
  classId    String
  class      Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  name       String // Green, Red, Blue, A, B
  group      String? // Science, Business Studies, Humanities, General
  roomNumber String?
  capacity   Int     @default(40)

  students           Student[]
  routines           TimetableEntry[]
  attendanceSessions AttendanceSession[]
  teacherAssignments TeacherAssignment[]
  examSchedules      ExamSchedule[]
  enrollments        Enrollment[]

  @@index([classId])
}

model Subject {
  id              String @id @default(uuid())
  classId         String
  class           Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  name            String // Bangla, Mathematics, Physics, Quran Mazid
  code            String
  type            String @default("COMPULSORY") // COMPULSORY, ELECTIVE, OPTIONAL, 4TH_SUBJECT
  fullMarks       Int    @default(100)
  passMarks       Int    @default(33)
  theoryMarks     Int    @default(70)
  practicalMarks  Int    @default(0)
  assignmentMarks Int    @default(20)
  attendanceMarks Int    @default(10)

  marksEntries       MarksEntry[]
  studentSubjectRegs StudentSubjectRegistration[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  examSchedules      ExamSchedule[]

  @@index([classId])
}

model Course {
  id             String  @id @default(uuid())
  programId      String
  program        Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  code           String // CSE-301
  title          String // Database Management Systems
  creditHours    Float   @default(3.0)
  lectureCredits Float   @default(3.0)
  labCredits     Float   @default(0.0)
  prerequisites  String? // "CSE-101"
  courseType     String  @default("CORE")

  courseRegistrations CourseRegistration[]
  courseOfferings     CourseOffering[]
  curriculumCourses   CurriculumCourse[]
  prerequisitesMain   CoursePrerequisite[] @relation("CoursePrereqMain")
  prerequisiteFor     CoursePrerequisite[] @relation("CoursePrereqRequired")
  examSchedules       ExamSchedule[]

  @@index([programId])
}

model CoursePrerequisite {
  id                   String @id @default(uuid())
  courseId             String
  course               Course @relation("CoursePrereqMain", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourseId String
  prerequisiteCourse   Course @relation("CoursePrereqRequired", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)
  minGradePoint        Float  @default(2.00) // Minimum C / 2.0 to satisfy

  @@unique([courseId, prerequisiteCourseId])
  @@index([courseId])
}

model CourseOffering {
  id            String     @id @default(uuid())
  courseId      String
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sectionName   String // "Section A", "Section 1"
  teacherId     String?
  teacher       Teacher?   @relation(fields: [teacherId], references: [id])
  classroomId   String?
  classroom     Classroom? @relation(fields: [classroomId], references: [id])
  capacity      Int        @default(45)
  enrolledCount Int        @default(0)
  scheduleJson  String? // JSON: [{"dayOfWeek":"SUNDAY","startTime":"09:00","endTime":"10:30"}]
  status        String     @default("OPEN") // OPEN, CLOSED, CANCELLED
  createdAt     DateTime   @default(now())

  registrations    CourseRegistration[]
  timetableEntries TimetableEntry[]
  marksEntries     MarksEntry[]
  examSchedules    ExamSchedule[]

  @@unique([courseId, sessionId, sectionName])
  @@index([sessionId])
}

// ----------------------------------------------------
// 5. Students & Guardians (SIS)
// ----------------------------------------------------

model Student {
  id       String  @id @default(uuid())
  campusId String
  campus   Campus  @relation(fields: [campusId], references: [id])
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id])

  studentIdNumber    String // e.g. "STU-2026-0001"
  admissionNumber    String
  rollNumber         String?
  registrationNumber String?

  // Personal Info
  firstName          String
  lastName           String
  photoUrl           String?
  dateOfBirth        DateTime
  gender             String
  bloodGroup         String?
  religion           String?
  nationality        String   @default("Bangladeshi")
  nidBirthCertNumber String?

  // Contact Info
  presentAddress   String
  permanentAddress String
  phone            String?
  email            String?

  // Academic Links
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])
  batchId   String?
  batch     Batch?   @relation(fields: [batchId], references: [id])
  status    String   @default("ACTIVE") // ACTIVE, PROMOTED, GRADUATED, DROPPED_OUT, TRANSFERRED

  // Guardian Link
  guardianId    String?
  guardian      Guardian?         @relation(fields: [guardianId], references: [id])
  guardianLinks StudentGuardian[]

  // Relations
  enrollments             Enrollment[]
  courseRegistrations     CourseRegistration[]
  attendances             AttendanceRecord[]
  marks                   MarksEntry[]
  results                 Result[]
  invoices                Invoice[]
  scholarshipApplications ScholarshipApplication[]
  scholarshipAwards       ScholarshipAward[]
  feeWaivers              FeeWaiver[]
  creditBalance           StudentCreditBalance?
  creditTransactions      StudentCreditTransaction[]
  refundRequests          RefundRequest[]
  cheques                 ChequeRecord[]
  hifzRecords             HifzDailyRecord[]
  thesisRecords           ThesisRecord[]
  certificates            Certificate[]
  disciplineRecords       DisciplineRecord[]
  subjectRegistrations    StudentSubjectRegistration[]
  workshopLogs            WorkshopLogEntry[]
  industrialAttachments   IndustrialAttachment[]
  examEligibilities       ExamEligibility[]
  resultSnapshots         ExamResultSnapshot[]
  transcripts             OfficialTranscript[]
  promotionRecords        StudentPromotionRecord[]
  graduationRecord        GraduationRecord?

  // Command 7 Facilities
  libraryMemberships     LibraryMember[]
  hostelApplications     HostelApplication[]
  hostelAllocations      HostelAllocation[]
  hostelTransfers        HostelTransferHistory[]
  hostelAttendances      HostelAttendance[]
  transportSubscriptions TransportSubscription[]
  canteenWallets         CanteenWallet[]
  pickupAuthorizations   StudentPickupAuthorization[]

  // Command 8 LMS
  lmsLessonProgresses      LmsLessonProgress[]
  lmsCourseProgresses      LmsCourseProgress[]
  lmsHomeworkSubmissions   LmsHomeworkSubmission[]
  lmsAssignmentSubmissions LmsAssignmentSubmission[]
  lmsQuizAttempts          LmsQuizAttempt[]
  lmsOnlineClassAttendance LmsOnlineClassAttendance[]
  lmsGradebookScores       LmsGradebookScore[]
  lmsActivityLogs          LmsLearningActivityLog[]
  createdAt                DateTime                   @default(now())

  @@index([campusId])
  @@index([studentIdNumber])
  @@index([status])
}

model Guardian {
  id               String  @id @default(uuid())
  userId           String? @unique
  user             User?   @relation(fields: [userId], references: [id])
  fatherName       String
  fatherPhone      String
  fatherProfession String?
  motherName       String
  motherPhone      String?
  motherProfession String?
  guardianName     String
  guardianPhone    String
  guardianRelation String  @default("Father")
  address          String?
  emergencyContact String?

  students     Student[]
  studentLinks StudentGuardian[]
}

model StudentGuardian {
  id               String   @id @default(uuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId       String
  guardian         Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationshipType String   @default("PRIMARY") // PRIMARY, SECONDARY, EMERGENCY, FINANCIAL, PICKUP
  isPrimary        Boolean  @default(false)
  canPickup        Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
}

// ----------------------------------------------------
// 6. Admission Engine & Online Testing
// ----------------------------------------------------

model AdmissionApplication {
  id             String       @id @default(uuid())
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId       String
  campus         Campus       @relation(fields: [campusId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  applicationNumber String   @unique // e.g. "APP-2026-0001"
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            String
  bloodGroup        String?
  religion          String?
  phone             String
  email             String?
  presentAddress    String
  permanentAddress  String

  desiredClassId   String?
  desiredClass     Class?   @relation(fields: [desiredClassId], references: [id])
  desiredProgramId String?
  desiredProgram   Program? @relation(fields: [desiredProgramId], references: [id])

  guardianName       String
  guardianPhone      String
  guardianRelation   String  @default("Father")
  guardianOccupation String?

  previousSchool String?
  previousGpa    Float?

  status               String @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, VERIFIED, TEST_ELIGIBLE, TESTED, INTERVIEW, SELECTED, WAITLISTED, REJECTED, ADMITTED
  applicationFeeStatus String @default("PENDING") // PENDING, PAID
  testScore            Float?
  meritRank            Int?

  testAttempts AdmissionTestAttempt[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([institutionId, status])
  @@index([applicationNumber])
}

model AdmissionTest {
  id              String      @id @default(uuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title           String // "Grade 6 Admission Assessment 2026"
  durationMinutes Int         @default(30)
  totalMarks      Float       @default(100)
  passMarks       Float       @default(40)
  questionsJson   String // Stored JSON array of MCQ questions
  isActive        Boolean     @default(true)

  attempts AdmissionTestAttempt[]

  @@index([institutionId])
}

model AdmissionTestAttempt {
  id            String               @id @default(uuid())
  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  testId        String
  test          AdmissionTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  startedAt     DateTime             @default(now())
  submittedAt   DateTime?
  answersJson   String? // JSON mapping questionId -> selectedOption
  score         Float?
  isEvaluated   Boolean              @default(false)

  @@index([applicationId])
  @@index([testId])
}

model Enrollment {
  id             String        @id @default(uuid())
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        Session?      @relation(fields: [sessionId], references: [id])
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  classId        String?
  class          Class?        @relation(fields: [classId], references: [id])
  sectionId      String?
  section        Section?      @relation(fields: [sectionId], references: [id])
  rollNumber     String?
  status         String        @default("ACTIVE") // ACTIVE, COMPLETED, PROMOTED, REPEATED, DROPPED
  enrollmentDate DateTime      @default(now())
  academicStatus String        @default("REGULAR")

  @@index([studentId])
  @@index([sessionId])
  @@index([academicYearId])
}

model CourseRegistration {
  id               String          @id @default(uuid())
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course          @relation(fields: [courseId], references: [id])
  courseOfferingId String?
  courseOffering   CourseOffering? @relation(fields: [courseOfferingId], references: [id])
  semester         String
  status           String          @default("ENROLLED") // ENROLLED, DROPPED, RETAKE, COMPLETED
  gradePoint       Float?
  letterGrade      String?
  createdAt        DateTime        @default(now())

  @@index([studentId, courseId])
  @@index([courseOfferingId])
}

// ----------------------------------------------------
// 7. Madrasha Engine & Hifzul Quran
// ----------------------------------------------------

model HifzDailyRecord {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())

  // Sabak (New Lesson)
  sabakPara      Int? // 1..30
  sabakSurah     String?
  sabakAyatStart Int?
  sabakAyatEnd   Int?
  sabakGrade     String? // Excellent, Very Good, Good, Fair, Revision

  // Sabki (Recent Revision)
  sabkiPara  Int?
  sabkiPages Int?
  sabkiGrade String?

  // Dour (Full Revision)
  dourParaStart Int?
  dourParaEnd   Int?
  dourGrade     String?

  totalParasMemorized Float   @default(0)
  teacherNotes        String?
  evaluatedBy         String?

  @@index([studentId, date])
}

// ----------------------------------------------------
// 8. Higher Ed: Thesis & Research
// ----------------------------------------------------

model ThesisRecord {
  id                String    @id @default(uuid())
  studentId         String
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title             String
  abstract          String?
  supervisorName    String
  coSupervisorName  String?
  status            String    @default("PROPOSAL_SUBMITTED")
  proposalDate      DateTime?
  defenseDate       DateTime?
  defenseGrade      String?
  defenseScore      Float?
  plagiarismPercent Float?
  fileUrl           String?

  @@index([studentId])
}

model ResearchProject {
  id                    String      @id @default(uuid())
  institutionId         String
  institution           Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title                 String
  principalInvestigator String
  department            String
  fundingAgency         String?
  grantAmount           Float       @default(0)
  startDate             DateTime
  endDate               DateTime?
  status                String      @default("ONGOING")
  publicationsCount     Int         @default(0)

  @@index([institutionId])
}

// ----------------------------------------------------
// 9. HR, Employees & Workforce Management (Command 6)
// ----------------------------------------------------

model Employee {
  id       String  @id @default(uuid())
  campusId String
  campus   Campus  @relation(fields: [campusId], references: [id])
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id])

  employeeCode  String
  firstName     String
  lastName      String
  photoUrl      String?
  designation   String
  department    String?
  departmentId  String?
  departmentRel Department? @relation(fields: [departmentId], references: [id])
  positionId    String?
  position      Position?   @relation(fields: [positionId], references: [id])

  supervisorId String?
  supervisor   Employee?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  subordinates Employee[] @relation("EmployeeSupervisor")

  category     String  @default("TEACHING") // TEACHING, NON_TEACHING, ADMINISTRATIVE, MANAGEMENT, SUPPORT, DRIVER, SECURITY, MAINTENANCE, OTHER
  status       String  @default("ACTIVE") // PRE_HIRE, ACTIVE, PROBATION, CONFIRMED, ON_LEAVE, SUSPENDED, NOTICE_PERIOD, RESIGNED, TERMINATED, RETIRED, CONTRACT_ENDED, DECEASED, INACTIVE
  academicRank String? // Lecturer, Senior Lecturer, Assistant Professor, Associate Professor, Professor, Dean, Emeritus, Visiting Professor

  joiningDate    DateTime
  employmentType String   @default("PERMANENT") // PERMANENT, PROBATIONARY, CONTRACT, TEMPORARY, PART_TIME, VISITING, INTERN, CONSULTANT, HOURLY, OTHER
  basicSalary    Float
  phone          String
  email          String
  nidNumber      String?

  dateOfBirth              DateTime?
  gender                   String?
  nationality              String?   @default("Bangladeshi")
  bloodGroup               String?
  presentAddress           String?
  permanentAddress         String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  teacherProfile        Teacher?
  facultyProfile        FacultyProfile?
  bankAccount           EmployeeBankAccount?
  documents             EmployeeDocument[]
  qualifications        EmployeeQualification[]
  experiences           EmployeeExperience[]
  contracts             EmploymentContract[]
  onboardings           EmployeeOnboarding[]
  rosterShifts          EmployeeRoster[]
  attendances           EmployeeDailyAttendance[]
  rawPunches            EmployeeRawPunch[]
  attendanceCorrections AttendanceCorrectionRequest[]
  overtimeRequests      OvertimeRequest[]
  leaveBalances         EmployeeLeaveBalance[]
  leaveLedgers          EmployeeLeaveLedger[]
  leaves                LeaveApplication[]
  employeeLeaves        EmployeeLeaveApplication[]
  promotions            EmployeePromotionHistory[]
  transfers             EmployeeTransferHistory[]
  increments            EmployeeIncrementRequest[]
  additionalDuties      EmployeeAdditionalDuty[]
  skills                EmployeeSkill[]
  goals                 EmployeeGoal[]
  performanceReviews    EmployeePerformanceReview[]
  trainings             EmployeeTrainingEnrollment[]
  disciplinaryCases     EmployeeDisciplinaryCase[]
  warnings              EmployeeWarning[]
  grievances            EmployeeGrievance[]
  separation            EmployeeSeparation?

  payrolls               PayrollRecord[]
  salaryAssignments      EmployeeSalaryAssignment[]
  loans                  EmployeeLoan[]
  salaryAdvances         SalaryAdvance[]
  convertedFromCandidate JobCandidate?

  // Command 7 Facilities
  libraryMemberships     LibraryMember[]
  assignedFixedAssets    FixedAsset[]
  assetAssignments       AssetAssignmentHistory[]
  transportSubscriptions TransportSubscription[]
  canteenWallets         CanteenWallet[]
  purchaseRequisitions   PurchaseRequisition[]
  assignedVehicles       TransportVehicle[]

  // Command 8 LMS
  lmsCoursesPrimary        LmsCourse[]               @relation("LmsPrimaryTeacher")
  lmsAssignmentSubmissions LmsAssignmentSubmission[]
  lmsOnlineClasses         LmsOnlineClass[]          @relation("OnlineClassTeacher")

  createdAt DateTime @default(now())

  @@index([campusId])
  @@index([employeeCode])
  @@index([departmentId])
  @@index([positionId])
  @@index([status])
}

model Position {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String?
  campus        Campus?     @relation(fields: [campusId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  positionCode        String
  title               String
  category            String     @default("TEACHING")
  grade               String?
  reportsToPositionId String?
  reportsToPosition   Position?  @relation("PositionHierarchy", fields: [reportsToPositionId], references: [id])
  childPositions      Position[] @relation("PositionHierarchy")

  authorizedHeadcount Int      @default(1)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  employees       Employee[]
  jobRequisitions JobRequisition[]
  jobVacancies    JobVacancy[]
  jobOffers       JobOffer[]

  @@unique([institutionId, positionCode])
  @@index([institutionId])
  @@index([departmentId])
}

model FacultyProfile {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  academicRank     String   @default("Lecturer") // Lecturer, Senior Lecturer, Assistant Professor, Associate Professor, Professor, Emeritus, Visiting Professor
  specialization   String?
  researchArea     String?
  officeRoom       String?
  officeHours      String?
  biography        String?
  orcidId          String?
  googleScholarUrl String?
  createdAt        DateTime @default(now())
}

model EmployeeDocument {
  id                 String    @id @default(uuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType       String // NID, PASSPORT, CV, ACADEMIC_CERTIFICATE, EXPERIENCE_CERTIFICATE, APPOINTMENT_LETTER, CONTRACT, DRIVING_LICENSE, POLICE_VERIFICATION, OTHER
  title              String
  documentNumber     String?
  issueDate          DateTime?
  expiryDate         DateTime?
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  fileUrl            String
  createdAt          DateTime  @default(now())

  @@index([employeeId])
  @@index([expiryDate])
}

model EmployeeQualification {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  degree         String
  subject        String
  institution    String
  country        String   @default("Bangladesh")
  passingYear    Int
  resultGrade    String
  certificateUrl String?
  createdAt      DateTime @default(now())

  @@index([employeeId])
}

model EmployeeExperience {
  id               String    @id @default(uuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employerName     String
  positionTitle    String
  startDate        DateTime
  endDate          DateTime?
  durationMonths   Int?
  referenceContact String?
  createdAt        DateTime  @default(now())

  @@index([employeeId])
}

model JobRequisition {
  id                 String      @id @default(uuid())
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  requisitionNumber  String
  positionId         String
  position           Position    @relation(fields: [positionId], references: [id])
  requestedHeadcount Int         @default(1)
  reason             String
  requiredByDate     DateTime
  status             String      @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  requestedBy        String
  approvedBy         String?
  createdAt          DateTime    @default(now())

  @@unique([institutionId, requisitionNumber])
  @@index([institutionId])
}

model JobVacancy {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String?
  campus        Campus?     @relation(fields: [campusId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  positionId    String
  position      Position    @relation(fields: [positionId], references: [id])

  vacancyCode      String
  title            String
  jobType          String   @default("BOTH") // INTERNAL, EXTERNAL, BOTH
  employmentType   String   @default("PERMANENT")
  responsibilities String
  requirements     String
  closingDate      DateTime
  status           String   @default("DRAFT") // DRAFT, PUBLISHED, CLOSED, CANCELLED
  createdAt        DateTime @default(now())

  candidates JobCandidate[]

  @@unique([institutionId, vacancyCode])
  @@index([institutionId])
}

model JobCandidate {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vacancyId     String
  vacancy       JobVacancy  @relation(fields: [vacancyId], references: [id])

  applicantNumber      String
  firstName            String
  lastName             String
  email                String
  phone                String
  cvUrl                String?
  highestQualification String?
  experienceYears      Float   @default(0)
  source               String  @default("DIRECT") // DIRECT, PORTAL, REFERRAL, AGENCY
  stage                String  @default("APPLIED") // APPLIED, SCREENING, SHORTLISTED, WRITTEN_TEST, INTERVIEW, REFERENCE_CHECK, SELECTED, OFFERED, HIRED, REJECTED, WITHDRAWN

  convertedEmployeeId String?   @unique
  convertedEmployee   Employee? @relation(fields: [convertedEmployeeId], references: [id])
  createdAt           DateTime  @default(now())

  interviews CandidateInterview[]
  offers     JobOffer[]

  @@unique([institutionId, applicantNumber])
  @@index([institutionId])
  @@index([vacancyId])
}

model CandidateInterview {
  id             String       @id @default(uuid())
  candidateId    String
  candidate      JobCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewDate  DateTime
  roundName      String // "Initial Screening", "Technical Demo", "Panel Interview"
  interviewers   String // Comma separated or JSON string
  criteriaScores String? // JSON string of breakdown scores
  totalScore     Float?
  comments       String?
  recommendation String       @default("HOLD") // HIRE, REJECT, HOLD, NEXT_ROUND
  createdAt      DateTime     @default(now())

  @@index([candidateId])
}

model JobOffer {
  id            String       @id @default(uuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     JobCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  positionId    String
  position      Position     @relation(fields: [positionId], references: [id])

  offerNumber         String
  employmentType      String   @default("PERMANENT")
  proposedJoiningDate DateTime
  offeredGrossSalary  Float
  expiryDate          DateTime
  status              String   @default("DRAFT") // DRAFT, APPROVED, SENT, ACCEPTED, DECLINED, EXPIRED, WITHDRAWN
  approvedBy          String?
  createdAt           DateTime @default(now())

  @@unique([institutionId, offerNumber])
  @@index([institutionId])
}

model EmployeeOnboarding {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateName   String    @default("Standard Staff Onboarding")
  tasks          String // JSON string of checklist items
  status         String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  completionDate DateTime?
  createdAt      DateTime  @default(now())

  @@index([employeeId])
}

model EmploymentContract {
  id                   String    @id @default(uuid())
  employeeId           String
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractNumber       String
  contractType         String    @default("PERMANENT") // PERMANENT, PROBATIONARY, FIXED_TERM, CONTRACT
  startDate            DateTime
  endDate              DateTime?
  probationEndDate     DateTime?
  grossSalaryReference Float
  termsAndConditions   String?
  status               String    @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED, RENEWED
  createdAt            DateTime  @default(now())

  @@index([employeeId])
}

model EmployeeBankAccount {
  id                     String   @id @default(uuid())
  employeeId             String   @unique
  employee               Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bankName               String
  branchName             String
  accountName            String
  accountNumberMasked    String // e.g. "************1234"
  accountNumberEncrypted String? // Optional encrypted payload
  routingNumber          String?
  createdAt              DateTime @default(now())
}

model HrShift {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  shiftCode     String
  name          String
  startTime     String // "08:00"
  endTime       String // "16:00"
  graceMinutes  Int         @default(15)
  breakMinutes  Int         @default(60)
  workingHours  Float       @default(8.0)
  isNightShift  Boolean     @default(false)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  rosters     EmployeeRoster[]
  attendances EmployeeDailyAttendance[]

  @@unique([institutionId, shiftCode])
  @@index([institutionId])
}

model EmployeeRoster {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      HrShift  @relation(fields: [shiftId], references: [id])
  rosterDate DateTime
  createdAt  DateTime @default(now())

  @@unique([employeeId, rosterDate])
  @@index([employeeId])
  @@index([shiftId])
}

model EmployeeRawPunch {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  punchTime     DateTime
  punchType     String // ENTRY, EXIT
  deviceSource  String      @default("BIOMETRIC") // BIOMETRIC, RFID, MOBILE, WEB, MANUAL_IMPORT
  deviceId      String?
  ipAddress     String?
  createdAt     DateTime    @default(now())

  @@index([institutionId])
  @@index([employeeId, punchTime])
}

model EmployeeDailyAttendance {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate DateTime
  shiftId        String?
  shift          HrShift?    @relation(fields: [shiftId], references: [id])

  checkInTime           DateTime?
  checkOutTime          DateTime?
  status                String    @default("PRESENT") // PRESENT, ABSENT, LATE, LEAVE, HALF_DAY, OFF_DAY, HOLIDAY, REMOTE
  lateMinutes           Int       @default(0)
  earlyDepartureMinutes Int       @default(0)
  actualWorkingHours    Float     @default(0)
  overtimeHours         Float     @default(0)
  source                String    @default("MANUAL") // MANUAL, BIOMETRIC, RFID, WEB, MOBILE, IMPORT
  remarks               String?
  createdAt             DateTime  @default(now())

  @@unique([employeeId, attendanceDate])
  @@index([institutionId])
  @@index([employeeId])
  @@index([attendanceDate])
}

model AttendanceCorrectionRequest {
  id                String    @id @default(uuid())
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate    DateTime
  originalStatus    String
  requestedStatus   String
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String
  status            String    @default("REQUESTED") // REQUESTED, APPROVED, REJECTED
  reviewedBy        String?
  reviewComment     String?
  createdAt         DateTime  @default(now())

  @@index([employeeId])
}

model OvertimeRequest {
  id                 String   @id @default(uuid())
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  overtimeDate       DateTime
  hours              Float
  reason             String
  status             String   @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, PROCESSED_IN_PAYROLL
  approvedBy         String?
  approvedHourlyRate Float?
  createdAt          DateTime @default(now())

  @@index([employeeId])
}

model HrLeaveType {
  id                  String      @id @default(uuid())
  institutionId       String
  institution         Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  code                String // CASUAL, SICK, ANNUAL, MATERNITY, PATERNITY, UNPAID, STUDY, SABBATICAL
  name                String
  isPaid              Boolean     @default(true)
  annualQuotaDays     Int         @default(14)
  carryForwardMaxDays Int         @default(0)
  requiresProof       Boolean     @default(false)
  createdAt           DateTime    @default(now())

  policies     HrLeavePolicy[]
  balances     EmployeeLeaveBalance[]
  ledgers      EmployeeLeaveLedger[]
  applications EmployeeLeaveApplication[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model HrLeavePolicy {
  id                String      @id @default(uuid())
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  leaveTypeId       String
  leaveType         HrLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  employmentType    String      @default("PERMANENT")
  category          String      @default("TEACHING")
  annualEntitlement Int         @default(14)
  accrualFrequency  String      @default("ANNUAL") // ANNUAL, MONTHLY, PRORATED
  createdAt         DateTime    @default(now())

  @@index([institutionId])
}

model EmployeeLeaveBalance {
  id             String      @id @default(uuid())
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      HrLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year           Int
  openingBalance Float       @default(0)
  earned         Float       @default(0)
  used           Float       @default(0)
  adjusted       Float       @default(0)
  carriedForward Float       @default(0)
  closingBalance Float       @default(0)
  createdAt      DateTime    @default(now())

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
}

model EmployeeLeaveLedger {
  id              String      @id @default(uuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       HrLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  transactionDate DateTime    @default(now())
  transactionType String // ACCRUAL, APPLICATION_DEDUCTION, CANCELLATION_RESTORE, MANUAL_ADJUSTMENT, YEAR_END_LAPSE
  days            Float
  balanceAfter    Float
  referenceId     String?
  reason          String?
  createdAt       DateTime    @default(now())

  @@index([employeeId])
}

model EmployeeLeaveApplication {
  id              String      @id @default(uuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       HrLeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime
  endDate         DateTime
  totalDays       Float
  isHalfDay       Boolean     @default(false)
  halfDayType     String? // FIRST_HALF, SECOND_HALF
  reason          String
  attachmentUrl   String?
  status          String      @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())

  @@index([employeeId])
  @@index([leaveTypeId])
}

model EmployeePromotionHistory {
