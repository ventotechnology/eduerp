}

model EmployeeAdditionalDuty {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dutyTitle       String // e.g. "Acting Head of Department", "Cultural Coordinator"
  startDate       DateTime
  endDate         DateTime?
  allowanceAmount Float     @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([employeeId])
}

model EmployeeSkill {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillName        String
  proficiencyLevel String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  createdAt        DateTime @default(now())

  @@index([employeeId])
}

model PerformanceCycle {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String // "Annual Appraisal 2026", "Spring 2026 Faculty Review"
  startDate     DateTime
  endDate       DateTime
  status        String      @default("ACTIVE") // ACTIVE, CLOSED
  createdAt     DateTime    @default(now())

  goals   EmployeeGoal[]
  reviews EmployeePerformanceReview[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model EmployeeGoal {
  id                  String           @id @default(uuid())
  employeeId          String
  employee            Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId             String
  cycle               PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  title               String
  weightagePercentage Float            @default(20.0)
  targetMetric        String
  achievementScore    Float?
  employeeSelfComment String?
  managerComment      String?
  status              String           @default("IN_PROGRESS") // IN_PROGRESS, ACHIEVED, PARTIALLY_ACHIEVED, MISSED
  createdAt           DateTime         @default(now())

  @@index([employeeId])
  @@index([cycleId])
}

model EmployeePerformanceReview {
  id                   String           @id @default(uuid())
  employeeId           String
  employee             Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId              String
  cycle                PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewerId           String
  teachingScore        Float?
  researchScore        Float?
  serviceScore         Float?
  overallScore         Float?
  rating               String? // OUTSTANDING, EXCEEDS_EXPECTATIONS, MEETS_EXPECTATIONS, NEEDS_IMPROVEMENT
  selfReviewSummary    String?
  managerReviewSummary String?
  moderationComment    String?
  status               String           @default("DRAFT") // DRAFT, SUBMITTED, MODERATED, FINALIZED
  createdAt            DateTime         @default(now())

  @@index([employeeId])
  @@index([cycleId])
}

model TrainingProgram {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  provider      String
  trainingType  String      @default("PEDAGOGY") // PEDAGOGY, TECHNICAL, LEADERSHIP, COMPLIANCE, WORKSHOP
  startDate     DateTime
  endDate       DateTime
  capacity      Int         @default(30)
  cost          Float       @default(0)
  createdAt     DateTime    @default(now())

  enrollments EmployeeTrainingEnrollment[]

  @@index([institutionId])
}

model EmployeeTrainingEnrollment {
  id                String          @id @default(uuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trainingProgramId String
  trainingProgram   TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  status            String          @default("NOMINATED") // NOMINATED, APPROVED, COMPLETED, DROPPED
  completionDate    DateTime?
  certificateUrl    String?
  createdAt         DateTime        @default(now())

  @@index([employeeId])
  @@index([trainingProgramId])
}

model EmployeeDisciplinaryCase {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  caseNumber     String
  incidentDate   DateTime
  allegation     String
  evidenceUrls   String? // JSON string
  explanation    String?
  findings       String?
  outcomeAction  String      @default("NO_ACTION") // NO_ACTION, WARNING, SUSPENSION, TERMINATION
  status         String      @default("OPEN") // OPEN, UNDER_INVESTIGATION, CONCLUDED
  investigatedBy String?
  createdAt      DateTime    @default(now())

  @@unique([institutionId, caseNumber])
  @@index([institutionId])
  @@index([employeeId])
}

model EmployeeWarning {
  id                    String   @id @default(uuid())
  employeeId            String
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  warningLevel          String // VERBAL, WRITTEN, FINAL
  issueDate             DateTime
  reason                String
  issuedBy              String
  acknowledgementStatus String   @default("ISSUED") // ISSUED, ACKNOWLEDGED
  createdAt             DateTime @default(now())

  @@index([employeeId])
}

model EmployeeGrievance {
  id                String      @id @default(uuid())
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ticketNumber      String
  subject           String
  details           String
  isConfidential    Boolean     @default(true)
  assignedTo        String?
  status            String      @default("SUBMITTED") // SUBMITTED, INVESTIGATING, RESOLVED, CLOSED
  resolutionSummary String?
  createdAt         DateTime    @default(now())

  @@unique([institutionId, ticketNumber])
  @@index([institutionId])
  @@index([employeeId])
}

model EmployeeSeparation {
