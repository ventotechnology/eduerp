  requestDate      DateTime    @default(now())
  noticePeriodDays Int         @default(30)
  lastWorkingDate  DateTime
  reason           String
  status           String      @default("SUBMITTED") // SUBMITTED, APPROVED, CLEARANCE_IN_PROGRESS, COMPLETED
