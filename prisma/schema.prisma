  facilities Facility[]

  @@unique([campusId, code])
  @@index([campusId])
}

model Classroom {
  id                String    @id @default(uuid())
  campusId          String
  campus            Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  buildingId        String?
  building          Building? @relation(fields: [buildingId], references: [id])
  floorNumber       Int?      @default(1)
  roomNumber        String
  capacity          Int
  type              String    @default("CLASSROOM") // CLASSROOM, LAB, WORKSHOP, AUDITORIUM, SEMINAR
  hasProjector      Boolean   @default(false)
  hasAirConditioner Boolean   @default(false)

  routines        TimetableEntry[]
  courseOfferings CourseOffering[]
  examSchedules   ExamSchedule[]

  @@index([campusId])
}

model Period {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String?
  shiftId       String?
  shift         Shift?      @relation(fields: [shiftId], references: [id])
  periodNumber  Int
  name          String // "Period 1", "Period 2", "Tiffin Break"
  startTime     String // "08:00"
  endTime       String // "08:45"
  isBreak       Boolean     @default(false)

  timetableEntries      TimetableEntry[]
  teacherAvailabilities TeacherAvailability[]

  @@index([institutionId])
}

model TeacherAvailability {
  id          String  @id @default(uuid())
  teacherId   String
  teacher     Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek   String // SUNDAY, MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY
  periodId    String?
  period      Period? @relation(fields: [periodId], references: [id])
  startTime   String?
  endTime     String?
  isAvailable Boolean @default(true)
  reason      String?

  @@index([teacherId, dayOfWeek])
}

model TeacherAssignment {
  id               String       @id @default(uuid())
  teacherId        String
  teacher          Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYearId   String
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?     @relation(fields: [subjectId], references: [id])
  courseOfferingId String?
  classId          String?
  class            Class?       @relation(fields: [classId], references: [id])
  sectionId        String?
  section          Section?     @relation(fields: [sectionId], references: [id])
  weeklyPeriods    Int          @default(4)
  createdAt        DateTime     @default(now())

  @@index([teacherId])
  @@index([sectionId])
}

model TimetableEntry {
  id               String          @id @default(uuid())
  institutionId    String
  institution      Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYearId   String?
  academicYear     AcademicYear?   @relation(fields: [academicYearId], references: [id])
  sessionId        String?
  session          Session?        @relation(fields: [sessionId], references: [id])
  campusId         String?
  campus           Campus?         @relation(fields: [campusId], references: [id])
  sectionId        String?
  section          Section?        @relation(fields: [sectionId], references: [id])
  courseOfferingId String?
  courseOffering   CourseOffering? @relation(fields: [courseOfferingId], references: [id])
  subjectId        String?
  subject          Subject?        @relation(fields: [subjectId], references: [id])
  periodId         String?
  period           Period?         @relation(fields: [periodId], references: [id])
  classroomId      String
  classroom        Classroom       @relation(fields: [classroomId], references: [id])
  teacherId        String?
  teacher          Teacher?        @relation(fields: [teacherId], references: [id])
  dayOfWeek        String // SUNDAY, MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY
  startTime        String // "09:00"
  endTime          String // "09:45"
  subjectName      String
  teacherName      String
  isDoublePeriod   Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@index([classroomId, dayOfWeek, startTime])
  @@index([sectionId, dayOfWeek, startTime])
  @@index([teacherId, dayOfWeek, startTime])
}

model TechnologyTrade {
  id                String      @id @default(uuid())
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name              String // "Computer Technology", "Electrical Technology"
  code              String // CMT, ET, CT
  btebCode          String? // "685"
  durationSemesters Int         @default(8)
  description       String?

  @@unique([institutionId, code])
  @@index([institutionId])
}

model WorkshopLogEntry {
  id               String   @id @default(uuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date             DateTime @default(now())
  taskTitle        String // "Microcontroller Interfacing Lab Experiment 4"
  instructorName   String
  completionStatus String   @default("COMPLETED") // COMPLETED, PENDING, RE_SUBMIT
  score            Float? // 0..100
  teacherRemarks   String?

  @@index([studentId, date])
}

model IndustrialAttachment {
  id               String    @id @default(uuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organizationName String // "Walton Hi-Tech Industries PLC"
  supervisorName   String
  startDate        DateTime
  endDate          DateTime?
  evaluationScore  Float?
  reportStatus     String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, APPROVED

  @@index([studentId])
}

model AcademicCalendarEvent {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String?
  title         String // "Midterm Examination", "Eid-ul-Fitr Holiday", "Admission Open"
  eventType     String // EXAM, HOLIDAY, ADMISSION, REGISTRATION, RESULT, CONVOCATION, EVENT
  startDate     DateTime
  endDate       DateTime
  description   String?
  isHoliday     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([institutionId, startDate])
}

// ----------------------------------------------------
// 11. Examinations, Marks, Transcripts & Progression
// ----------------------------------------------------

model AssessmentComponent {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String // "Written", "MCQ", "Practical", "Quiz", "Assignment", "Midterm", "Final"
  code          String // "TH", "MCQ", "PRAC", "ATT", "ASG"
  maxMarks      Float
  passMarks     Float
  weight        Float       @default(1.0)
  sequence      Int         @default(1)
  isRequired    Boolean     @default(true)
  roundingRule  String      @default("HALF_UP") // HALF_UP, CEIL, FLOOR, NONE
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId])
}

model MarkDistributionTemplate {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name           String // "Secondary School Science (70-20-10)", "University Engineering (10-10-10-30-40)"
  code           String
  academicLevel  String? // SCHOOL, COLLEGE, UNIVERSITY, POLYTECHNIC, MADRASHA
  componentsJson String // JSON array of AssessmentComponent objects
  totalMarks     Float
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Exam {
  id                  String       @id @default(uuid())
  institutionId       String?
  institution         Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sessionId           String
  session             Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name                String // "Half Yearly Examination 2026", "Spring 2026 Midterm"
  type                String // TERM, MIDTERM, FINAL, ANNUAL, PRE_TEST, TEST, UNIVERSITY_MIDTERM, UNIVERSITY_FINAL, CUSTOM
  examTypeCode        String       @default("TERM")
  termNumber          Int          @default(1)
  targetClassId       String?
  targetClass         Class?       @relation(fields: [targetClassId], references: [id])
  targetProgramId     String?
  targetProgram       Program?     @relation(fields: [targetProgramId], references: [id])
  startDate           DateTime
  endDate             DateTime
  markEntryDeadline   DateTime?
  moderationDeadline  DateTime?
  publicationDeadline DateTime?
  publicationStatus   String       @default("INTERNAL") // INTERNAL, PENDING_PUBLICATION, PUBLISHED, WITHHELD
  isPublished         Boolean      @default(false)
  publishedAt         DateTime?
  publishedBy         String?

  marksEntries     MarksEntry[]
  results          Result[]
  schedules        ExamSchedule[]
  eligibilities    ExamEligibility[]
  resultSnapshots  ExamResultSnapshot[]
  promotionBatches PromotionBatch[]

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([institutionId])
}

model ExamSchedule {
  id               String          @id @default(uuid())
  examId           String
  exam             Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  courseId         String?
  course           Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseOfferingId String?
  courseOffering   CourseOffering? @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  classId          String?
  class            Class?          @relation(fields: [classId], references: [id])
  sectionId        String?
  section          Section?        @relation(fields: [sectionId], references: [id])
  date             DateTime
  startTime        String // "09:00"
  endTime          String // "12:00"
  durationMinutes  Int             @default(180)
  roomId           String?
  room             Classroom?      @relation(fields: [roomId], references: [id])
  invigilatorName  String?
  invigilatorId    String?
  maxMarks         Float           @default(100)
  instructions     String?
  status           String          @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, POSTPONED, CANCELLED
  createdAt        DateTime        @default(now())

  @@index([examId, date])
  @@index([roomId, date])
}

model ExamEligibility {
  id                   String    @id @default(uuid())
  examId               String
  exam                 Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId            String
  student              Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status               String    @default("ELIGIBLE") // ELIGIBLE, INELIGIBLE_ATTENDANCE, INELIGIBLE_FINANCIAL, INELIGIBLE_ACADEMIC, OVERRIDDEN
  attendancePercentage Float?
  financialClearance   Boolean   @default(true)
  isOverridden         Boolean   @default(false)
  overrideReason       String?
  overriddenBy         String?
  overriddenAt         DateTime?
  hallTicketNumber     String?
  createdAt            DateTime  @default(now())

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

model MarksEntry {
  id               String          @id @default(uuid())
  examId           String
  exam             Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  courseOfferingId String?
  courseOffering   CourseOffering? @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  theoryMarks         Float          @default(0)
  practicalMarks      Float          @default(0)
  assignmentMarks     Float          @default(0)
  attendanceMarks     Float          @default(0)
  totalMarks          Float
  letterGrade         String
  gradePoint          Float
  status              String         @default("PASS") // PASS, FAIL
  workflowStatus      String         @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, LOCKED, RETURNED_FOR_CORRECTION
  markStatus          String         @default("MARK") // MARK, ABSENT, EXEMPT, WITHHELD, INCOMPLETE
  componentScoresJson String? // JSON: {"TH": 55, "MCQ": 18, "PRAC": 22}
  enteredByUserId     String?
  submittedAt         DateTime?
  submittedBy         String?
  reviewedAt          DateTime?
  reviewedBy          String?
  approvedAt          DateTime?
  approvedBy          String?
  isLocked            Boolean        @default(false)
  lockedAt            DateTime?
  lockedBy            String?
  remarks             String?
  changeLogs          MarkAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([examId])
  @@index([studentId])
}

model MarkAuditLog {
  id              String     @id @default(uuid())
  marksEntryId    String
  marksEntry      MarksEntry @relation(fields: [marksEntryId], references: [id], onDelete: Cascade)
  previousScore   Float
  newScore        Float
  componentName   String
  previousStatus  String?
  newStatus       String?
  reason          String
  changedByUserId String
  changedByName   String
  changedAt       DateTime   @default(now())

  @@index([marksEntryId])
}

model GradingScale {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  gradeType     String // SCHOOL_GPA_5, UNIVERSITY_CGPA_4

  @@index([institutionId])
}

model Result {
  id        String  @id @default(uuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  totalMarks  Float
  gpaOrCgpa   Float
  letterGrade String
  position    Int?
  isPassed    Boolean @default(true)
  remarks     String?

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

model ExamResultSnapshot {
  id                   String    @id @default(uuid())
  examId               String
  exam                 Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId            String
  student              Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  version              Int       @default(1)
  isCurrent            Boolean   @default(true)
  gpa                  Float
  cgpa                 Float?
  totalMarks           Float
  percentage           Float
  letterGrade          String
  isPassed             Boolean
  failedSubjectsCount  Int       @default(0)
  positionInClass      Int?
  positionInSection    Int?
  subjectResultsJson   String // JSON snapshot of all subjects, components, points, credits
  gradingScaleSnapshot String // JSON snapshot of grade boundaries applied
  publicationStatus    String    @default("PUBLISHED") // INTERNAL, PENDING_PUBLICATION, PUBLISHED, WITHHELD
  correctionReason     String?
  approvedBy           String?
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())

  @@unique([examId, studentId, version])
  @@index([examId, studentId])
}

model OfficialTranscript {
  id                    String      @id @default(uuid())
  institutionId         String
  institution           Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId             String
  student               Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transcriptType        String // SEMESTER, UNOFFICIAL, PROVISIONAL, FINAL_ACADEMIC
  transcriptNumber      String      @unique // "TR-2026-000123"
  issueDate             DateTime    @default(now())
  totalCreditsCompleted Float
  cgpa                  Float
  degreeAwarded         String?
  academicStatus        String      @default("GOOD_STANDING") // GOOD_STANDING, PROBATION, SUSPENDED, GRADUATED
  dataSnapshotJson      String // Full immutable semester roadmap, courses, retakes, GPA, CGPA
  issuedBy              String
  qrVerificationUrl     String
  isRevoked             Boolean     @default(false)
  createdAt             DateTime    @default(now())

  @@index([institutionId])
  @@index([studentId])
}

model Certificate {
  id                String      @id @default(uuid())
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificateType   String // STUDENT, ENROLLMENT, BONAFIDE, CHARACTER, TESTIMONIAL, TRANSFER, COURSE_COMPLETION, GRADUATION, PROVISIONAL, CUSTOM
  certificateNumber String      @unique // "CERT-2026-000123"
  studentName       String?
  fatherName        String?
  motherName        String?
  programOrClass    String?
  gpaOrDivision     String?
  passingYear       Int?
  issueDate         DateTime    @default(now())
  integrityHash     String      @default("") // Cryptographic verification hash (HMAC-SHA256)
  qrVerificationUrl String
  isRevoked         Boolean     @default(false)
  revocationReason  String?
  revokedBy         String?
  revokedAt         DateTime?
  signatoryTitle    String?     @default("Principal")
  metadataJson      String?
  createdAt         DateTime    @default(now())

  @@index([institutionId])
  @@index([studentId])
}

model PromotionBatch {
  id                 String                   @id @default(uuid())
  institutionId      String
  institution        Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  examId             String?
  exam               Exam?                    @relation(fields: [examId], references: [id])
  fromAcademicYearId String
  toAcademicYearId   String
  fromClassId        String
  toClassId          String? // Null if graduating from terminal class
  processedBy        String
  processedAt        DateTime                 @default(now())
  totalStudents      Int
  promotedCount      Int
  repeatedCount      Int
  conditionalCount   Int
  graduatedCount     Int
  rulesAppliedJson   String // JSON snapshot of promotion rules applied
  records            StudentPromotionRecord[]
  createdAt          DateTime                 @default(now())

  @@index([institutionId])
}

model StudentPromotionRecord {
  id                 String         @id @default(uuid())
  promotionBatchId   String
  promotionBatch     PromotionBatch @relation(fields: [promotionBatchId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status             String // PROMOTED, CONDITIONALLY_PROMOTED, REPEAT, WITHHELD, GRADUATED
  finalGpa           Float
  isPassed           Boolean
  failedSubjectCodes String? // JSON array of failed subject codes
  fromSectionId      String?
  toSectionId        String?
  isOverridden       Boolean        @default(false)
  overrideReason     String?
  overriddenBy       String?
  createdAt          DateTime       @default(now())

  @@index([promotionBatchId])
  @@index([studentId])
}

model GraduationRecord {
  id                     String      @id @default(uuid())
  institutionId          String
  institution            Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId              String      @unique
  student                Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId              String
  program                Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  graduationDate         DateTime
  finalCgpa              Float
  totalCreditsCompleted  Float
  degreeClassification   String // "Distinction", "First Class", "Merit", etc.
  thesisTitle            String?
  internshipOrganization String?
  convocationBatch       String?
  certificateNumber      String?
  isApproved             Boolean     @default(true)
  approvedBy             String
  createdAt              DateTime    @default(now())

  @@index([institutionId])
}

// ----------------------------------------------------
// 12. Fees, Billing, Scholarships, Accounting & Payroll Engine (COMMAND 5)
// ----------------------------------------------------

model FiscalYear {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String // "FY 2025-2026"
  startDate     DateTime
  endDate       DateTime
  status        String      @default("OPEN") // DRAFT, OPEN, CLOSING, CLOSED, ARCHIVED
  isCurrent     Boolean     @default(false)

  periods        FiscalPeriod[]
  journalEntries JournalEntry[]
  budgets        Budget[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model FiscalPeriod {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  fiscalYearId   String?
  fiscalYear     FiscalYear? @relation(fields: [fiscalYearId], references: [id])
  name           String // "July 2026", "Q1 2026"
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean     @default(false)
  closedAt       DateTime?
  closedBy       String?
  reopenedAt     DateTime?
  reopenedBy     String?
  reopenedReason String?

  journalEntries JournalEntry[]

  @@index([institutionId])
}

model ChartOfAccount {
  id            String           @id @default(uuid())
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  code          String // "1000", "1100", "1110"
  name          String // "Assets", "Current Assets", "Cash on Hand"
  type          String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  subtype       String? // CASH, BANK, ACCOUNTS_RECEIVABLE, FIXED_ASSET, ACCOUNTS_PAYABLE, SALARY_PAYABLE, TAX_PAYABLE, TUITION_REVENUE, SALARY_EXPENSE, OTHER_EXPENSE
  parentId      String?
  parent        ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children      ChartOfAccount[] @relation("AccountHierarchy")
  isHeader      Boolean          @default(false) // Non-postable header
  balance       Float            @default(0)
  currency      String           @default("BDT")
  isActive      Boolean          @default(true)

  journalLines JournalLine[]
  budgetLines  BudgetLine[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model CostCenter {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  code          String
  name          String
  departmentId  String?
  campusId      String?
  isActive      Boolean     @default(true)

  journalLines JournalLine[]
  budgetLines  BudgetLine[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Fund {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  code          String
  name          String // "General Fund", "Scholarship Fund"
  isActive      Boolean     @default(true)

  journalLines JournalLine[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model AccountMapping {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  mappingKey    String // DEFAULT_CASH, DEFAULT_BANK, DEFAULT_ACCOUNTS_RECEIVABLE, DEFAULT_TUITION_REVENUE, DEFAULT_ACCOUNTS_PAYABLE, DEFAULT_SALARY_EXPENSE, etc.
  accountId     String

  @@unique([institutionId, mappingKey])
  @@index([institutionId])
}

model JournalEntry {
  id             String        @id @default(uuid())
  institutionId  String
  institution    Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  fiscalYearId   String?
  fiscalYear     FiscalYear?   @relation(fields: [fiscalYearId], references: [id])
  fiscalPeriodId String?
  fiscalPeriod   FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id])
  entryNumber    String        @unique // "JV-2026-000001"
  entryDate      DateTime      @default(now())
  description    String
  reference      String?
  sourceType     String        @default("MANUAL") // MANUAL, FEE_COLLECTION, FEE_BILLING, PAYROLL, REFUND, VENDOR_PAYMENT, EXPENSE
  sourceId       String?
  status         String        @default("POSTED") // DRAFT, SUBMITTED, APPROVED, POSTED, REVERSED, VOID
  postedBy       String?
  approvedBy     String?
  isPosted       Boolean       @default(true)
  isReversed     Boolean       @default(false)
  reversalOfId   String?
  reversalReason String?

  lines JournalLine[]

  createdAt DateTime @default(now())

  @@index([institutionId])
  @@index([entryDate])
}

model JournalLine {
  id             String         @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  costCenterId   String?
  costCenter     CostCenter?    @relation(fields: [costCenterId], references: [id])
  fundId         String?
  fund           Fund?          @relation(fields: [fundId], references: [id])
  debitAmount    Float          @default(0)
  creditAmount   Float          @default(0)
  memo           String?

  @@index([journalEntryId])
  @@index([accountId])
}

model FeeType {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String // "Tuition Fee", "Admission Fee", "Exam Fee", "Transport Fee", "Hostel Fee", "Lab Fee"
  code          String
  description   String?
  isTaxable     Boolean     @default(false)
  taxRate       Float       @default(0)
  isActive      Boolean     @default(true)

  feeStructures FeeStructure[]
  lateFeeRules  LateFeeRule[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model FeeStructure {
  id              String      @id @default(uuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  feeTypeId       String?
  feeType         FeeType?    @relation(fields: [feeTypeId], references: [id])
  name            String
  amount          Float
  frequency       String // ONE_TIME, MONTHLY, QUARTERLY, TERM, SEMESTER, ANNUAL, CUSTOM
  academicYearId  String?
  targetClassId   String?
  targetProgramId String?
  targetClass     String?
  targetProgram   String?
  dueDayOfMonth   Int?        @default(10)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())

  @@index([institutionId])
}

model LateFeeRule {
  id              String      @id @default(uuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  feeTypeId       String?
  feeType         FeeType?    @relation(fields: [feeTypeId], references: [id])
  gracePeriodDays Int         @default(10)
  fineType        String      @default("FLAT") // FLAT, DAILY, PERCENTAGE
  fineAmount      Float       @default(100)
  maxFineAmount   Float       @default(1000)
  isActive        Boolean     @default(true)

  @@index([institutionId])
}

model ScholarshipMaster {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String // "Merit Scholarship", "Need-Based Aid"
  code          String
  type          String      @default("MERIT") // MERIT, NEED_BASED, GOVERNMENT, INSTITUTIONAL, SPORTS, SPECIAL
  benefitType   String      @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT
  benefitValue  Float // e.g. 50% or 5000 BDT
  criteria      String?
  isActive      Boolean     @default(true)

  applications ScholarshipApplication[]
  awards       ScholarshipAward[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model ScholarshipApplication {
  id              String            @id @default(uuid())
  institutionId   String
  institution     Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  scholarshipId   String
  scholarship     ScholarshipMaster @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationDate DateTime          @default(now())
  requestedAmount Float?
  reason          String
  documentsUrl    String?
  status          String            @default("PENDING") // PENDING, UNDER_REVIEW, RECOMMENDED, APPROVED, REJECTED
  reviewedBy      String?
  reviewRemarks   String?
  approvedBy      String?
  approvedAt      DateTime?

  awards ScholarshipAward[]

  @@index([institutionId])
  @@index([studentId])
}

model ScholarshipAward {
  id                 String                  @id @default(uuid())
  institutionId      String
  institution        Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  scholarshipId      String
  scholarship        ScholarshipMaster       @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationId      String?
  application        ScholarshipApplication? @relation(fields: [applicationId], references: [id])
  awardType          String                  @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT
  awardValue         Float
  effectiveStartDate DateTime
  effectiveEndDate   DateTime
  status             String                  @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  approvedBy         String
  createdAt          DateTime                @default(now())

  @@index([institutionId])
  @@index([studentId])
}

model FeeWaiver {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceId     String?
  waiverType    String      @default("TUITION_WAIVER") // TUITION_WAIVER, FINE_WAIVER, FULL_WAIVER, PARTIAL_WAIVER
  amount        Float
  reason        String
  approvedBy    String
  status        String      @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt     DateTime    @default(now())

  @@index([institutionId])
  @@index([studentId])
}

model Invoice {
  id                String   @id @default(uuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceNumber     String   @unique
  title             String
  billingPeriod     String? // "September 2026", "Spring 2026 Semester"
  subTotal          Float
  scholarshipAmount Float    @default(0)
  discountAmount    Float    @default(0)
  discountReason    String?
  waiverAmount      Float    @default(0)
  fineAmount        Float    @default(0)
  taxAmount         Float    @default(0)
  totalAmount       Float
  paidAmount        Float    @default(0)
  dueAmount         Float
  advanceApplied    Float    @default(0)
  dueDate           DateTime
  status            String   @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED, REFUNDED

  payments       PaymentTransaction[]
  allocations    PaymentAllocation[]
  refundRequests RefundRequest[]
  createdAt      DateTime             @default(now())

  @@index([studentId])
  @@index([status])
}

model PaymentTransaction {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transactionRef String   @unique
  gateway        String // BKASH, NAGAD, ROCKET, CARDS, CASH, BANK_TRANSFER, CHEQUE
  amount         Float
  paidAt         DateTime @default(now())
  receiptNumber  String   @unique
  status         String   @default("SUCCESS")

  allocations PaymentAllocation[]

  @@index([invoiceId])
}

model PaymentAllocation {
  id              String             @id @default(uuid())
  paymentId       String
  payment         PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  allocatedAmount Float
  createdAt       DateTime           @default(now())

  @@index([paymentId])
  @@index([invoiceId])
}

model StudentCreditBalance {
  id              String      @id @default(uuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId       String      @unique
  student         Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  availableCredit Float       @default(0)
  updatedAt       DateTime    @updatedAt

  @@index([institutionId])
}

model StudentCreditTransaction {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Float
  type      String // ADVANCE_PAYMENT, ALLOCATED_TO_INVOICE, REFUND
  reference String?
  createdAt DateTime @default(now())

  @@index([studentId])
}

model RefundRequest {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentId      String?
  invoiceId      String?
  invoice        Invoice?    @relation(fields: [invoiceId], references: [id])
  amount         Float
  reason         String
  requestedBy    String
  status         String      @default("REQUESTED") // REQUESTED, REVIEWED, APPROVED, PROCESSED, REJECTED
  approvedBy     String?
  approvedAt     DateTime?
  processedBy    String?
  processedAt    DateTime?
  journalEntryId String?
  createdAt      DateTime    @default(now())

  @@index([institutionId])
  @@index([studentId])
}

model InstitutionBankAccount {
  id                  String      @id @default(uuid())
  institutionId       String
  institution         Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  bankName            String
  branchName          String?
  accountName         String
  accountNumberMasked String // "****-****-5678"
  currency            String      @default("BDT")
  ledgerAccountId     String?
  openingBalance      Float       @default(0)
  currentBalance      Float       @default(0)
  isActive            Boolean     @default(true)

  cheques         ChequeRecord[]
  reconciliations BankReconciliation[]

  @@index([institutionId])
}

model ChequeRecord {
  id            String                  @id @default(uuid())
  institutionId String
  institution   Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  bankAccountId String?
  bankAccount   InstitutionBankAccount? @relation(fields: [bankAccountId], references: [id])
  studentId     String?
  student       Student?                @relation(fields: [studentId], references: [id])
  vendorId      String?
  vendor        Vendor?                 @relation(fields: [vendorId], references: [id])
  chequeNumber  String
  bankName      String
  chequeDate    DateTime
  amount        Float
  type          String                  @default("RECEIVED") // RECEIVED, ISSUED
  status        String                  @default("RECEIVED") // RECEIVED, DEPOSITED, CLEARED, BOUNCED, CANCELLED
  depositDate   DateTime?
  clearanceDate DateTime?
  bounceReason  String?
  createdAt     DateTime                @default(now())

  @@index([institutionId])
}

model BankReconciliation {
  id                     String                 @id @default(uuid())
  institutionId          String
  institution            Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  bankAccountId          String
  bankAccount            InstitutionBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  statementDate          DateTime
  statementEndingBalance Float
  bookEndingBalance      Float
  difference             Float
  status                 String                 @default("DRAFT") // DRAFT, RECONCILED
  reconciledBy           String?
  reconciledAt           DateTime?
  createdAt              DateTime               @default(now())

  @@index([institutionId])
}

model Vendor {
  id               String      @id @default(uuid())
  institutionId    String
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vendorCode       String
  name             String
  contactPerson    String?
  email            String?
  phone            String
  address          String?
  taxIdNumber      String?
  paymentTermsDays Int         @default(30)
  ledgerAccountId  String?
  status           String      @default("ACTIVE")

  bills             VendorBill[]
  cheques           ChequeRecord[]
  expenseRequests   ExpenseRequest[]
  vendorQuotations  VendorQuotation[]
  purchaseOrders    PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  fixedAssets       FixedAsset[]
  canteens          Canteen[]
  createdAt         DateTime           @default(now())

  @@unique([institutionId, vendorCode])
  @@index([institutionId])
}

model VendorBill {
  id               String      @id @default(uuid())
  institutionId    String
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vendorId         String
  vendor           Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  billNumber       String
  billDate         DateTime
  dueDate          DateTime
  subTotal         Float
  taxAmount        Float       @default(0)
  totalAmount      Float
  paidAmount       Float       @default(0)
  dueAmount        Float
  status           String      @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, CANCELLED
  expenseAccountId String?
  journalEntryId   String?
  createdAt        DateTime    @default(now())

  @@unique([institutionId, billNumber])
  @@index([institutionId])
  @@index([vendorId])
}

model ExpenseRequest {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  category       String // UTILITIES, MAINTENANCE, OFFICE_SUPPLIES, TRAVEL, ACADEMIC_MATERIALS, PETTY_CASH, MISC
  title          String
  amount         Float
  requestedBy    String
  department     String?
  vendorId       String?
  vendor         Vendor?     @relation(fields: [vendorId], references: [id])
  status         String      @default("PENDING") // PENDING, APPROVED, PAID, REJECTED
  approvedBy     String?
  paidAt         DateTime?
  paymentMethod  String? // CASH, BANK_TRANSFER, CHEQUE
  receiptUrl     String?
  journalEntryId String?
  createdAt      DateTime    @default(now())

  @@index([institutionId])
}

model Budget {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  fiscalYearId  String
  fiscalYear    FiscalYear  @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  totalBudget   Float
  revisedBudget Float?
  status        String      @default("DRAFT") // DRAFT, APPROVED, REVISED, ARCHIVED
  approvedBy    String?

  lines     BudgetLine[]
  revisions BudgetRevisionLog[]
  createdAt DateTime            @default(now())

  @@index([institutionId])
}

model BudgetLine {
  id              String         @id @default(uuid())
  budgetId        String
  budget          Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId       String
  account         ChartOfAccount @relation(fields: [accountId], references: [id])
  departmentId    String?
  campusId        String?
  costCenterId    String?
  costCenter      CostCenter?    @relation(fields: [costCenterId], references: [id])
  allocatedAmount Float
  revisedAmount   Float?
  spentAmount     Float          @default(0)

  revisions BudgetRevisionLog[]

  @@index([budgetId])
  @@index([accountId])
}

model BudgetRevisionLog {
  id             String      @id @default(uuid())
  budgetId       String
  budget         Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetLineId   String?
  budgetLine     BudgetLine? @relation(fields: [budgetLineId], references: [id])
  previousAmount Float
  newAmount      Float
  reason         String
  revisedBy      String
  createdAt      DateTime    @default(now())

  @@index([budgetId])
}

model SalaryStructure {
  id                     String      @id @default(uuid())
  institutionId          String
  institution            Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name                   String // "Standard Teaching Faculty", "Administrative Staff"
  basicPercentage        Float       @default(50)
  houseRentPercentage    Float       @default(30)
  medicalPercentage      Float       @default(10)
  transportAllowance     Float       @default(2000)
  pfEmployeePercentage   Float       @default(8.33)
  pfEmployerPercentage   Float       @default(8.33)
  taxDeductionPercentage Float       @default(0)
  isActive               Boolean     @default(true)

  assignments EmployeeSalaryAssignment[]
  createdAt   DateTime                   @default(now())

  @@index([institutionId])
}

model EmployeeSalaryAssignment {
  id                String          @id @default(uuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  grossSalary       Float
  effectiveDate     DateTime
  status            String          @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt         DateTime        @default(now())

  @@index([employeeId])
}

model PayrollPeriod {
  id              String      @id @default(uuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name            String // "August 2026"
  startDate       DateTime
  endDate         DateTime
  totalGrossPay   Float       @default(0)
  totalDeductions Float       @default(0)
  totalNetPay     Float       @default(0)
  status          String      @default("DRAFT") // DRAFT, CALCULATED, REVIEWED, APPROVED, POSTED, PAID, CLOSED
  approvedBy      String?
  journalEntryId  String?

  records   PayrollRecord[]
  createdAt DateTime        @default(now())

  @@index([institutionId])
}

model EmployeeLoan {
  id                 String      @id @default(uuid())
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  principalAmount    Float
  monthlyInstallment Float
  totalPaid          Float       @default(0)
  remainingBalance   Float
  startDate          DateTime
  status             String      @default("ACTIVE") // ACTIVE, CLOSED, PAUSED
  createdAt          DateTime    @default(now())

  @@index([institutionId])
  @@index([employeeId])
}

model SalaryAdvance {
  id              String      @id @default(uuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount          Float
  recoveredAmount Float       @default(0)
  remainingAmount Float
  advanceDate     DateTime
  status          String      @default("ACTIVE") // ACTIVE, RECOVERED
  createdAt       DateTime    @default(now())

  @@index([institutionId])
  @@index([employeeId])
}

// ----------------------------------------------------
// 13. Facilities: Library, Transport, Hostel, Assets
// ----------------------------------------------------

model Book {
  id              String  @id @default(uuid())
  campusId        String
  campus          Campus  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  isbn            String?
  title           String
  author          String
  category        String
  totalCopies     Int     @default(1)
  availableCopies Int     @default(1)
  shelfLocation   String?
  isEBook         Boolean @default(false)
  eBookFileUrl    String?

  @@index([campusId])
}

model Hostel {
  id         String  @id @default(uuid())
  campusId   String
  campus     Campus  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name       String
  type       String  @default("BOYS")
  totalRooms Int
  capacity   Int
  superName  String?

  @@index([campusId])
}

model Vehicle {
  id            String @id @default(uuid())
  campusId      String
  campus        Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  vehicleNumber String
  driverName    String
  driverPhone   String
  routeTitle    String
  capacity      Int
  currentLat    Float?
  currentLng    Float?
  status        String @default("IDLE")

  @@index([campusId])
}

model AssetRecord {
  id              String      @id @default(uuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assetTag        String // "AST-COMP-001"
  name            String
  category        String
  purchaseDate    DateTime
  purchaseCost    Float
  currentLocation String
  custodianName   String?
  condition       String      @default("GOOD")

  @@unique([institutionId, assetTag])
  @@index([institutionId])
}

// ----------------------------------------------------
// 14. LMS, Notices, Events, Custom Fields & Audit Logs
// ----------------------------------------------------

model Notice {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title          String
  content        String
  targetAudience String      @default("ALL")
  isEmergency    Boolean     @default(false)
  publishedAt    DateTime    @default(now())

  @@index([institutionId])
}

model Event {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime
  location      String?
  category      String      @default("ACADEMIC")

  @@index([institutionId])
}

model DisciplineRecord {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  incidentDate DateTime @default(now())
  title        String
  description  String
  severity     String
  actionTaken  String?
  reportedBy   String

  @@index([studentId])
}

model CustomField {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  entityType    String
  fieldLabel    String
  fieldType     String
  options       String?
  isRequired    Boolean     @default(false)

  @@index([institutionId])
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?
  userName      String
  userRole      String?
  action        String // "MARKS_UPDATED", "FEE_PAID", "SALARY_DISBURSED"
  resourceType  String // "Student", "Invoice", "MarksEntry", "Settings"
  resourceId    String?
  previousState String? // JSON string of previous state
  newState      String? // JSON string of new state
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime @default(now())

  @@index([tenantId, action])
  @@index([timestamp])
}

// ====================================================
// COMMAND 7: FACILITIES, CAMPUS OPERATIONS & LOGISTICS
// ====================================================

// ----------------------------------------------------
// 1. Generic Facility Master
// ----------------------------------------------------

model Facility {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String?
  campus        Campus?     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  code          String
  name          String
  type          String      @default("OTHER") // LIBRARY, HOSTEL, CANTEEN, SPORTS, AUDITORIUM, LAB, CLINIC, PARKING, WAREHOUSE, OTHER
  buildingId    String?
  building      Building?   @relation(fields: [buildingId], references: [id])
  floorLocation String?
  capacity      Int         @default(0)
  status        String      @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  metadata      String? // JSON config
  createdAt     DateTime    @default(now())

  bookings            FacilityBooking[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([campusId])
}

// ----------------------------------------------------
// 2. Library Management Engine
// ----------------------------------------------------

model Library {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String
  campus        Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  code          String
  name          String
  location      String?
  openingHours  String? // e.g. "08:00 AM - 08:00 PM"
  status        String      @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime    @default(now())

  catalogs   LibraryCatalog[]
  stocktakes LibraryStocktake[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([campusId])
}

model LibraryCatalog {
  id              String      @id @default(uuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  libraryId       String
  library         Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  title           String
  subtitle        String?
  isbn            String?
  author          String
  editor          String?
  publisher       String?
  edition         String?
  publicationYear Int?
  language        String      @default("English")
  category        String      @default("General")
  subject         String?
  resourceType    String      @default("BOOK") // BOOK, JOURNAL, MAGAZINE, THESIS, RESEARCH_PAPER, NEWSPAPER, EBOOK, DIGITAL_RESOURCE, AUDIO_VISUAL, OTHER
  keywords        String?
  description     String?
  coverImageUrl   String?
  isDigital       Boolean     @default(false)
  digitalFileUrl  String?
  createdAt       DateTime    @default(now())

  copies       LibraryCopy[]
  reservations BookReservation[]

  @@index([institutionId])
  @@index([libraryId])
  @@index([isbn])
  @@index([title])
}

model LibraryCopy {
  id                 String         @id @default(uuid())
  catalogId          String
  catalog            LibraryCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  accessionNumber    String
  barcode            String?
  qrCode             String?
  shelf              String?
  rack               String?
  condition          String         @default("GOOD") // NEW, GOOD, FAIR, POOR, DAMAGED
  acquisitionDate    DateTime       @default(now())
  acquisitionCost    Float          @default(0)
  availabilityStatus String         @default("AVAILABLE") // AVAILABLE, ISSUED, RESERVED, LOST, DAMAGED, REPAIR, WITHDRAWN
  createdAt          DateTime       @default(now())

  issues BookIssue[]

  @@unique([catalogId, accessionNumber])
  @@index([accessionNumber])
  @@index([barcode])
  @@index([availabilityStatus])
}

model LibraryBorrowingPolicy {
  id                String      @id @default(uuid())
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name              String
  memberType        String      @default("STUDENT") // STUDENT, TEACHER, STAFF, FACULTY
  maxBooks          Int         @default(3)
  loanDurationDays  Int         @default(14)
  renewalLimit      Int         @default(2)
  finePerOverdueDay Float       @default(5.0)
  graceDays         Int         @default(1)
  createdAt         DateTime    @default(now())

  members LibraryMember[]

  @@index([institutionId])
}

model LibraryMember {
  id               String                  @id @default(uuid())
  institutionId    String
  institution      Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  memberType       String                  @default("STUDENT") // STUDENT, EMPLOYEE
  studentId        String?
  student          Student?                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  employeeId       String?
  employee         Employee?               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  membershipNumber String
  policyId         String?
  policy           LibraryBorrowingPolicy? @relation(fields: [policyId], references: [id])
  status           String                  @default("ACTIVE") // ACTIVE, SUSPENDED, EXPIRED
  joinedAt         DateTime                @default(now())
  expiryDate       DateTime?
  createdAt        DateTime                @default(now())

  issues       BookIssue[]
  reservations BookReservation[]

  @@unique([institutionId, membershipNumber])
  @@index([institutionId])
  @@index([studentId])
  @@index([employeeId])
}

model BookIssue {
  id            String        @id @default(uuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  copyId        String
  copy          LibraryCopy   @relation(fields: [copyId], references: [id], onDelete: Cascade)
  memberId      String
  member        LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  returnDate    DateTime?
  renewCount    Int           @default(0)
  overdueDays   Int           @default(0)
  fineAmount    Float         @default(0)
  finePaid      Boolean       @default(false)
  status        String        @default("ISSUED") // ISSUED, RETURNED, OVERDUE, LOST, DAMAGED
  damageNotes   String?
  issuedBy      String?
  returnedBy    String?
  createdAt     DateTime      @default(now())

  @@index([institutionId])
  @@index([copyId])
  @@index([memberId])
  @@index([status])
}

model BookReservation {
  id              String         @id @default(uuid())
  institutionId   String
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  catalogId       String
  catalog         LibraryCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  memberId        String
  member          LibraryMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reservationDate DateTime       @default(now())
  priorityOrder   Int            @default(1)
  status          String         @default("PENDING") // PENDING, FULFILLED, CANCELLED, EXPIRED
  expiryDate      DateTime?
  createdAt       DateTime       @default(now())

  @@index([institutionId])
  @@index([catalogId])
  @@index([memberId])
}

model LibraryStocktake {
  id              String      @id @default(uuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  libraryId       String
  library         Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  stocktakeDate   DateTime    @default(now())
  totalScanned    Int         @default(0)
  foundCount      Int         @default(0)
  missingCount    Int         @default(0)
  damagedCount    Int         @default(0)
  wrongShelfCount Int         @default(0)
  status          String      @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  conductedBy     String?
  notes           String?
  createdAt       DateTime    @default(now())

  @@index([institutionId])
  @@index([libraryId])
}

// ----------------------------------------------------
// 3. Hostel Management Engine
// ----------------------------------------------------

model HostelMaster {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String
  campus        Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  code          String
  name          String
  type          String      @default("BOYS") // BOYS, GIRLS, FACULTY, INTERNATIONAL, OTHER
  address       String?
  wardenName    String?
  wardenPhone   String?
  capacity      Int         @default(100)
  status        String      @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime    @default(now())

  blocks       HostelBlock[]
  rooms        HostelRoom[]
  applications HostelApplication[]
  visitorLogs  HostelVisitorLog[]
  attendances  HostelAttendance[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([campusId])
}

model HostelBlock {
  id          String       @id @default(uuid())
  hostelId    String
  hostel      HostelMaster @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  name        String
  code        String
  totalFloors Int          @default(4)
  createdAt   DateTime     @default(now())

  rooms HostelRoom[]

  @@unique([hostelId, code])
  @@index([hostelId])
}

model HostelRoom {
  id                String       @id @default(uuid())
  hostelId          String
  hostel            HostelMaster @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  blockId           String?
  block             HostelBlock? @relation(fields: [blockId], references: [id])
  roomNumber        String
  floorNumber       Int          @default(1)
  roomType          String       @default("DOUBLE") // SINGLE, DOUBLE, TRIPLE, DORMITORY, CUSTOM
  capacity          Int          @default(2)
  monthlyRent       Float        @default(3000)
  hasAttachedBath   Boolean      @default(false)
  hasAirConditioner Boolean      @default(false)
  status            String       @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  createdAt         DateTime     @default(now())

  beds HostelBed[]

  @@unique([hostelId, roomNumber])
  @@index([hostelId])
}

model HostelBed {
  id        String     @id @default(uuid())
  roomId    String
  room      HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNumber String // e.g. "Bed-1", "Bed-A"
  status    String     @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, MAINTENANCE, BLOCKED
  createdAt DateTime   @default(now())

  allocations HostelAllocation[]

  @@unique([roomId, bedNumber])
  @@index([roomId])
  @@index([status])
}

model HostelApplication {
  id                String       @id @default(uuid())
  institutionId     String
  institution       Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostelId          String
  hostel            HostelMaster @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  preferredRoomType String       @default("DOUBLE")
  applicationDate   DateTime     @default(now())
  status            String       @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, ALLOCATED, REJECTED
  reviewedBy        String?
  reviewRemarks     String?
  createdAt         DateTime     @default(now())

  @@index([institutionId])
  @@index([studentId])
}

model HostelAllocation {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bedId          String
  bed            HostelBed   @relation(fields: [bedId], references: [id], onDelete: Cascade)
  allocationDate DateTime    @default(now())
  startDate      DateTime
  endDate        DateTime?
  depositAmount  Float       @default(0)
  monthlyFee     Float       @default(0)
  status         String      @default("ACTIVE") // ACTIVE, TRANSFERRED, VACATED
  allocatedBy    String?
  createdAt      DateTime    @default(now())

  checkIn   HostelCheckIn?
  transfers HostelTransferHistory[]

  @@index([institutionId])
  @@index([studentId])
  @@index([bedId])
}

model HostelCheckIn {
  id                  String           @id @default(uuid())
  allocationId        String           @unique
  allocation          HostelAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  checkInDate         DateTime         @default(now())
  initialBedCondition String           @default("GOOD")
  keyCardNumber       String?
  depositPaid         Float            @default(0)
  remarks             String?
  checkedInBy         String?
  createdAt           DateTime         @default(now())
}

model HostelTransferHistory {
  id            String           @id @default(uuid())
  allocationId  String
  allocation    HostelAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  previousBedId String
  newBedId      String
  transferDate  DateTime         @default(now())
  reason        String
  approvedBy    String?
  createdAt     DateTime         @default(now())

  @@index([allocationId])
  @@index([studentId])
}

model HostelVisitorLog {
  id                String       @id @default(uuid())
  institutionId     String
  institution       Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  hostelId          String
  hostel            HostelMaster @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  residentStudentId String
  visitorName       String
  visitorPhone      String
  visitorNid        String?
  relationship      String?
  purpose           String
  entryTime         DateTime     @default(now())
  exitTime          DateTime?
  approvedBy        String?
  createdAt         DateTime     @default(now())

  @@index([institutionId])
  @@index([hostelId])
}

model HostelAttendance {
  id         String       @id @default(uuid())
  hostelId   String
  hostel     HostelMaster @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime
  status     String       @default("PRESENT") // PRESENT, OUT, LEAVE, LATE_RETURN
  remarks    String?
  recordedBy String?
  createdAt  DateTime     @default(now())

  @@unique([hostelId, studentId, date])
  @@index([hostelId])
  @@index([studentId])
}

// ----------------------------------------------------
// 4. Transport Management Engine
// ----------------------------------------------------

model TransportVehicle {
  id                 String      @id @default(uuid())
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId           String
  campus             Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  vehicleNumber      String
  registrationNumber String?
  vehicleType        String      @default("BUS") // BUS, MINIBUS, MICROBUS, VAN, CAR
  makeModel          String
  capacity           Int         @default(40)
  manufactureYear    Int?
  fuelType           String      @default("DIESEL") // DIESEL, OCTANE, CNG, ELECTRIC
  ownership          String      @default("OWNED") // OWNED, LEASED, RENTED
  insuranceExpiry    DateTime?
  fitnessExpiry      DateTime?
  taxExpiry          DateTime?
  assignedDriverId   String?
  assignedDriver     Employee?   @relation(fields: [assignedDriverId], references: [id])
  driverName         String?
  driverPhone        String?
  status             String      @default("ACTIVE") // ACTIVE, MAINTENANCE, OUT_OF_SERVICE, RETIRED
  createdAt          DateTime    @default(now())

  subscriptions TransportSubscription[]
  trips         TripSchedule[]
  telemetryLogs GpsTelemetryRecord[]
  incidents     TransportIncident[]
  fuelLogs      FuelLog[]
  maintenances  VehicleMaintenanceRecord[]

  @@unique([institutionId, vehicleNumber])
  @@index([institutionId])
  @@index([campusId])
}

model TransportRoute {
  id               String      @id @default(uuid())
  institutionId    String
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId         String?
  campus           Campus?     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  routeCode        String
  routeName        String
  startPoint       String
  endPoint         String
  distanceKm       Float       @default(0)
  estimatedMinutes Int         @default(60)
  monthlyFee       Float       @default(2000)
  status           String      @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt        DateTime    @default(now())

  stops         RouteStop[]
  subscriptions TransportSubscription[]
  trips         TripSchedule[]
  incidents     TransportIncident[]

  @@unique([institutionId, routeCode])
  @@index([institutionId])
}

model RouteStop {
  id         String         @id @default(uuid())
  routeId    String
  route      TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopOrder  Int            @default(1)
  stopName   String
  pickupTime String // "07:15 AM"
  dropTime   String // "04:30 PM"
  latitude   Float?
  longitude  Float?
  feeZone    String?
  createdAt  DateTime       @default(now())

  pickupSubscriptions TransportSubscription[] @relation("PickupStop")
  dropSubscriptions   TransportSubscription[] @relation("DropStop")

  @@unique([routeId, stopOrder])
  @@index([routeId])
}

model TransportSubscription {
  id            String            @id @default(uuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  memberType    String            @default("STUDENT") // STUDENT, EMPLOYEE
  studentId     String?
  student       Student?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  employeeId    String?
  employee      Employee?         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  vehicleId     String?
  vehicle       TransportVehicle? @relation(fields: [vehicleId], references: [id])
  routeId       String
  route         TransportRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupStopId  String
  pickupStop    RouteStop         @relation("PickupStop", fields: [pickupStopId], references: [id], onDelete: Cascade)
  dropStopId    String
  dropStop      RouteStop         @relation("DropStop", fields: [dropStopId], references: [id], onDelete: Cascade)
  startDate     DateTime          @default(now())
  endDate       DateTime?
  monthlyFee    Float             @default(0)
  status        String            @default("ACTIVE") // ACTIVE, SUSPENDED, CANCELLED
  createdAt     DateTime          @default(now())

  boardingEvents TransportBoardingEvent[]

  @@index([institutionId])
  @@index([studentId])
  @@index([employeeId])
  @@index([routeId])
}

model TripSchedule {
  id                 String           @id @default(uuid())
  institutionId      String
  institution        Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  routeId            String
  route              TransportRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverName         String?
  tripType           String           @default("MORNING_PICKUP") // MORNING_PICKUP, EVENING_DROP, SPECIAL_EVENT
  scheduledStartTime String // "07:00 AM"
  scheduledEndTime   String // "08:30 AM"
  status             String           @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt          DateTime         @default(now())

  boardingEvents TransportBoardingEvent[]

  @@index([institutionId])
  @@index([routeId])
  @@index([vehicleId])
}

model TransportBoardingEvent {
  id             String                 @id @default(uuid())
  tripId         String?
  trip           TripSchedule?          @relation(fields: [tripId], references: [id])
  subscriptionId String?
  subscription   TransportSubscription? @relation(fields: [subscriptionId], references: [id])
  studentId      String?
  eventTime      DateTime               @default(now())
  eventType      String                 @default("BOARDED") // BOARDED, DISEMBARKED, MISSED, MANUAL_OVERRIDE
  source         String                 @default("MANUAL") // MANUAL, QR, RFID, NFC, DEVICE_API
  scannedBy      String?
  createdAt      DateTime               @default(now())

  @@index([tripId])
  @@index([subscriptionId])
}

model GpsTelemetryRecord {
  id             String           @id @default(uuid())
  vehicleId      String
  vehicle        TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deviceId       String
  latitude       Float
  longitude      Float
  speedKmH       Float            @default(0)
  headingDegrees Float            @default(0)
  accuracyMeters Float            @default(5)
  timestamp      DateTime         @default(now())
  source         String           @default("DEVICE_WEBHOOK") // DEVICE_WEBHOOK, SIMULATED, MANUAL_LOG
  createdAt      DateTime         @default(now())

  @@index([vehicleId, timestamp])
}

model TransportIncident {
  id               String           @id @default(uuid())
  institutionId    String
  institution      Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicleId        String
  vehicle          TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  routeId          String?
  route            TransportRoute?  @relation(fields: [routeId], references: [id])
  incidentDate     DateTime         @default(now())
  incidentType     String           @default("BREAKDOWN") // BREAKDOWN, ACCIDENT, DELAY, DISRUPTION, OTHER
  severity         String           @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  description      String
  actionTaken      String?
  reportedBy       String
  resolutionStatus String           @default("REPORTED") // REPORTED, INVESTIGATING, RESOLVED
  createdAt        DateTime         @default(now())

  @@index([institutionId])
  @@index([vehicleId])
}

model FuelLog {
  id              String           @id @default(uuid())
  institutionId   String
  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  logDate         DateTime         @default(now())
  quantityLiters  Float
  fuelCost        Float
  odometerReading Float
  receiptNumber   String?
  recordedBy      String?
  createdAt       DateTime         @default(now())

  @@index([institutionId])
  @@index([vehicleId])
}

model VehicleMaintenanceRecord {
  id                     String           @id @default(uuid())
  institutionId          String
  institution            Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicleId              String
  vehicle                TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceDate            DateTime         @default(now())
  serviceType            String           @default("ROUTINE") // ROUTINE, REPAIR, TIRE_CHANGE, OVERHAUL
  description            String
  cost                   Float            @default(0)
  odometerReading        Float            @default(0)
  nextServiceDueOdometer Float?
  nextServiceDueDate     DateTime?
  status                 String           @default("COMPLETED") // IN_PROGRESS, COMPLETED
  createdAt              DateTime         @default(now())

  @@index([institutionId])
  @@index([vehicleId])
}

// ----------------------------------------------------
// 5. Canteen Management Engine
// ----------------------------------------------------

model Canteen {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String
  campus        Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  code          String
  name          String
  operatorType  String      @default("INSTITUTION_OWNED") // INSTITUTION_OWNED, CONTRACT_VENDOR
  vendorId      String?
  vendor        Vendor?     @relation(fields: [vendorId], references: [id])
  status        String      @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime    @default(now())

  items    CanteenItem[]
  menus    CanteenMenu[]
  posSales CanteenPosSale[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([campusId])
}

model CanteenItem {
  id            String         @id @default(uuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  canteenId     String
  canteen       Canteen        @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  itemCode      String
  name          String
  category      String         @default("SNACKS") // BREAKFAST, LUNCH, SNACKS, BEVERAGES, BAKERY, OTHER
  salePrice     Float
  costPrice     Float          @default(0)
  taxPercent    Float          @default(0)
  isAvailable   Boolean        @default(true)
  stockItemId   String?
  stockItem     InventoryItem? @relation(fields: [stockItemId], references: [id])
  createdAt     DateTime       @default(now())

  saleItems CanteenSaleItem[]

  @@unique([canteenId, itemCode])
  @@index([institutionId])
  @@index([canteenId])
}

model CanteenMenu {
  id          String   @id @default(uuid())
  canteenId   String
  canteen     Canteen  @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  date        DateTime
  mealPeriod  String   @default("LUNCH") // BREAKFAST, LUNCH, AFTERNOON_SNACKS, DINNER
  itemIds     String // JSON array of CanteenItem IDs
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([canteenId, date])
}

model CanteenWallet {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userType       String      @default("STUDENT") // STUDENT, EMPLOYEE
  studentId      String?
  student        Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee?   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  walletNumber   String
  currentBalance Float       @default(0)
  status         String      @default("ACTIVE") // ACTIVE, LOCKED, SUSPENDED
  createdAt      DateTime    @default(now())

  ledgers       CanteenWalletLedger[]
  spendingLimit CanteenSpendingLimit?

  @@unique([institutionId, walletNumber])
  @@index([institutionId])
  @@index([studentId])
  @@index([employeeId])
}

model CanteenWalletLedger {
  id              String        @id @default(uuid())
  walletId        String
  wallet          CanteenWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactionType String        @default("PURCHASE") // DEPOSIT, PURCHASE, REFUND, ADJUSTMENT
  amount          Float // positive for credit/deposit, negative for purchase/debit
  balanceAfter    Float
  referenceId     String?
  notes           String?
  performedBy     String?
  createdAt       DateTime      @default(now())

  @@index([walletId])
  @@index([transactionType])
}

model CanteenSpendingLimit {
  id          String        @id @default(uuid())
  walletId    String        @unique
  wallet      CanteenWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  dailyLimit  Float         @default(500)
  weeklyLimit Float         @default(2500)
  createdAt   DateTime      @default(now())
}

model CanteenPosSale {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  canteenId      String
  canteen        Canteen     @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  saleNumber     String
  saleDate       DateTime    @default(now())
  buyerType      String      @default("STUDENT") // STUDENT, EMPLOYEE, GUEST
  studentId      String?
  employeeId     String?
  paymentMode    String      @default("CASH") // CASH, WALLET, CARD_ONLINE, CREDIT
  subtotal       Float
  taxAmount      Float       @default(0)
  discountAmount Float       @default(0)
  totalAmount    Float
  status         String      @default("COMPLETED") // COMPLETED, REFUNDED, CANCELLED
  cashierName    String?
  createdAt      DateTime    @default(now())

  saleItems CanteenSaleItem[]

  @@unique([institutionId, saleNumber])
  @@index([institutionId])
  @@index([canteenId])
}

model CanteenSaleItem {
  id         String         @id @default(uuid())
  saleId     String
  sale       CanteenPosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId     String
  item       CanteenItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemName   String
  unitPrice  Float
  quantity   Int            @default(1)
  totalPrice Float

  @@index([saleId])
}

// ----------------------------------------------------
// 6. Inventory & Warehouse Engine
// ----------------------------------------------------

model InventoryCategory {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  code          String
  description   String?
  createdAt     DateTime    @default(now())

  items InventoryItem[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Warehouse {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String?
  campus        Campus?     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  code          String
  name          String
  type          String      @default("CENTRAL_STORE") // CENTRAL_STORE, CAMPUS_STORE, DEPARTMENT_STORE, CANTEEN_STORE, LAB_STORE
  location      String?
  status        String      @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime    @default(now())

  stockLedgers      StockLedger[]
  transfersFrom     StockTransfer[]    @relation("TransferFrom")
  transfersTo       StockTransfer[]    @relation("TransferTo")
  issueRecords      StockIssueRecord[]
  goodsReceiptNotes GoodsReceiptNote[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model InventoryItem {
  id            String            @id @default(uuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  categoryId    String
  category      InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sku           String
  name          String
  unitOfMeasure String            @default("PCS") // PCS, BOX, KG, LTR, REAM, PACKET, SET
  reorderLevel  Float             @default(10)
  standardCost  Float             @default(0)
  trackSerial   Boolean           @default(false)
  trackBatch    Boolean           @default(false)
  hasExpiry     Boolean           @default(false)
  status        String            @default("ACTIVE") // ACTIVE, DISCONTINUED
  createdAt     DateTime          @default(now())

  canteenItems     CanteenItem[]
  stockLedgers     StockLedger[]
  transferItems    StockTransferItem[]
  issueItems       StockIssueItem[]
  requisitionItems PurchaseRequisitionItem[]
  poItems          PurchaseOrderItem[]
  grnItems         GoodsReceiptItem[]

  @@unique([institutionId, sku])
  @@index([institutionId])
  @@index([categoryId])
}

model StockLedger {
  id                String        @id @default(uuid())
  institutionId     String
  institution       Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  itemId            String
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transactionType   String // OPENING, PURCHASE_RECEIPT, ISSUE, RETURN, TRANSFER_OUT, TRANSFER_IN, ADJUSTMENT, DAMAGE, EXPIRY, DISPOSAL
  quantity          Float // positive or negative
  unitCost          Float         @default(0)
  totalValue        Float         @default(0)
  balanceAfterQty   Float         @default(0)
  balanceAfterValue Float         @default(0)
  referenceType     String? // PO, GRN, ISSUE_REQ, TRANSFER_REQ, MANUAL_ADJUSTMENT
  referenceId       String?
  notes             String?
  performedBy       String?
  createdAt         DateTime      @default(now())

  @@index([institutionId])
  @@index([warehouseId])
  @@index([itemId])
  @@index([transactionType])
}

model StockTransfer {
  id              String      @id @default(uuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  transferNumber  String
  fromWarehouseId String
  fromWarehouse   Warehouse   @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouseId   String
  toWarehouse     Warehouse   @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  transferDate    DateTime    @default(now())
  status          String      @default("PENDING") // PENDING, IN_TRANSIT, COMPLETED, CANCELLED
  requestedBy     String?
  approvedBy      String?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())

  items StockTransferItem[]

  @@unique([institutionId, transferNumber])
  @@index([institutionId])
}

model StockTransferItem {
  id           String        @id @default(uuid())
  transferId   String
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requestedQty Float
  sentQty      Float         @default(0)
  receivedQty  Float         @default(0)

  @@index([transferId])
}

model StockIssueRecord {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  issueNumber   String
  warehouseId   String
  warehouse     Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  issuedToType  String      @default("DEPARTMENT") // DEPARTMENT, EMPLOYEE, STUDENT, FACILITY
  departmentId  String?
  employeeId    String?
  studentId     String?
  facilityId    String?
  issueDate     DateTime    @default(now())
  purpose       String
  issuedBy      String?
  status        String      @default("ISSUED") // ISSUED, RETURNED_PARTIAL, RETURNED_FULL
  createdAt     DateTime    @default(now())

  items StockIssueItem[]

  @@unique([institutionId, issueNumber])
  @@index([institutionId])
  @@index([warehouseId])
}

model StockIssueItem {
  id            String           @id @default(uuid())
  issueRecordId String
  issueRecord   StockIssueRecord @relation(fields: [issueRecordId], references: [id], onDelete: Cascade)
  itemId        String
  item          InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity      Float
  unitCost      Float            @default(0)
  totalCost     Float            @default(0)

  @@index([issueRecordId])
}

// ----------------------------------------------------
// 7. Fixed Assets Management Engine
// ----------------------------------------------------

model FixedAsset {
  id                         String      @id @default(uuid())
  institutionId              String
  institution                Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId                   String
  campus                     Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  assetTag                   String // "AST-COMP-001"
  name                       String
  category                   String      @default("COMPUTER") // COMPUTER, LAPTOP, PROJECTOR, FURNITURE, AC, GENERATOR, VEHICLE, LAB_EQUIPMENT, SPORTS_EQUIPMENT, BUILDING_EQUIPMENT, OTHER
  serialNumber               String?
  purchaseDate               DateTime    @default(now())
  purchaseCost               Float       @default(0)
  supplierVendorId           String?
  supplierVendor             Vendor?     @relation(fields: [supplierVendorId], references: [id])
  warrantyExpiry             DateTime?
  warrantyProvider           String?
  currentBuildingId          String?
  currentRoomId              String?
  currentCustodianEmployeeId String?
  currentCustodianEmployee   Employee?   @relation(fields: [currentCustodianEmployeeId], references: [id])
  currentDepartmentId        String?
  depreciationMethod         String      @default("STRAIGHT_LINE") // STRAIGHT_LINE, WRITTEN_DOWN_VALUE, NONE
  depreciationRatePercent    Float       @default(10)
  salvageValue               Float       @default(0)
  accumulatedDepreciation    Float       @default(0)
  bookValue                  Float       @default(0)
  condition                  String      @default("GOOD") // EXCELLENT, GOOD, FAIR, POOR, DAMAGED
  status                     String      @default("ACTIVE") // ACTIVE, IN_STOCK, ASSIGNED, MAINTENANCE, DAMAGED, LOST, DISPOSED, RETIRED
  createdAt                  DateTime    @default(now())

  assignments  AssetAssignmentHistory[]
  maintenances AssetMaintenance[]
  disposal     AssetDisposal?

  @@unique([institutionId, assetTag])
  @@index([institutionId])
  @@index([campusId])
  @@index([assetTag])
  @@index([status])
}

model AssetAssignmentHistory {
  id                String     @id @default(uuid())
  assetId           String
  asset             FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedToType    String     @default("EMPLOYEE") // EMPLOYEE, DEPARTMENT, ROOM, CAMPUS
  employeeId        String?
  employee          Employee?  @relation(fields: [employeeId], references: [id])
  departmentId      String?
  roomId            String?
  assignedDate      DateTime   @default(now())
  returnDate        DateTime?
  conditionOnAssign String     @default("GOOD")
  conditionOnReturn String?
  remarks           String?
  assignedBy        String?
  createdAt         DateTime   @default(now())

  @@index([assetId])
  @@index([employeeId])
}

model AssetMaintenance {
  id             String     @id @default(uuid())
  assetId        String
  asset          FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  serviceDate    DateTime   @default(now())
  serviceType    String     @default("SERVICING") // REPAIR, SERVICING, PART_REPLACEMENT
  cost           Float      @default(0)
  vendorName     String?
  description    String
  performedBy    String?
  nextServiceDue DateTime?
  status         String     @default("COMPLETED") // IN_PROGRESS, COMPLETED
  createdAt      DateTime   @default(now())

  @@index([assetId])
}

model AssetDisposal {
  id               String     @id @default(uuid())
  assetId          String     @unique
  asset            FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  disposalDate     DateTime   @default(now())
  disposalType     String     @default("SCRAPPED") // SOLD, SCRAPPED, DONATED, LOST
  saleAmount       Float      @default(0)
  realizedGainLoss Float      @default(0)
  approvedBy       String?
  reason           String
  createdAt        DateTime   @default(now())
}

// ----------------------------------------------------
// 8. Procurement Engine
// ----------------------------------------------------

model PurchaseRequisition {
  id                    String      @id @default(uuid())
  institutionId         String
  institution           Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  requisitionNumber     String
  departmentId          String?
  requestedByEmployeeId String
  requestedByEmployee   Employee    @relation(fields: [requestedByEmployeeId], references: [id], onDelete: Cascade)
  requestDate           DateTime    @default(now())
  requiredByDate        DateTime
  purpose               String
  estimatedTotalCost    Float       @default(0)
  status                String      @default("SUBMITTED") // DRAFT, SUBMITTED, HOD_APPROVED, BUDGET_VERIFIED, APPROVED, PO_CREATED, REJECTED
  approvedBy            String?
  createdAt             DateTime    @default(now())

  items          PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]
  rfqs           RequestForQuotation[]

  @@unique([institutionId, requisitionNumber])
  @@index([institutionId])
  @@index([requestedByEmployeeId])
}

model PurchaseRequisitionItem {
  id                  String              @id @default(uuid())
  requisitionId       String
  requisition         PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  itemId              String?
  item                InventoryItem?      @relation(fields: [itemId], references: [id])
  itemName            String
  specification       String?
  quantity            Float
  estimatedUnitPrice  Float               @default(0)
  estimatedTotalPrice Float               @default(0)

  @@index([requisitionId])
}

model RequestForQuotation {
  id              String               @id @default(uuid())
  institutionId   String
  institution     Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  rfqNumber       String
  requisitionId   String?
  requisition     PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  title           String
  deadlineDate    DateTime
  status          String               @default("PUBLISHED") // PUBLISHED, CLOSED, AWARDED
  termsConditions String?
  createdAt       DateTime             @default(now())

  quotations VendorQuotation[]

  @@unique([institutionId, rfqNumber])
  @@index([institutionId])
}

model VendorQuotation {
  id                String               @id @default(uuid())
  rfqId             String?
  rfq               RequestForQuotation? @relation(fields: [rfqId], references: [id])
  institutionId     String
  institution       Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  quotationNumber   String
  submissionDate    DateTime             @default(now())
  validityDate      DateTime
  totalQuotedAmount Float
  paymentTerms      String?
  deliveryLeadDays  Int                  @default(7)
  attachmentUrl     String?
  status            String               @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, SELECTED, REJECTED
  reviewedBy        String?
  createdAt         DateTime             @default(now())

  items          VendorQuotationItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([institutionId, vendorId, quotationNumber])
  @@index([institutionId])
  @@index([vendorId])
}

model VendorQuotationItem {
  id          String          @id @default(uuid())
  quotationId String
  quotation   VendorQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemName    String
  quantity    Float
  unitPrice   Float
  taxPercent  Float           @default(0)
  totalPrice  Float

  @@index([quotationId])
}

model PurchaseOrder {
  id                   String               @id @default(uuid())
  institutionId        String
  institution          Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  poNumber             String
  requisitionId        String?
  requisition          PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  quotationId          String?
  quotation            VendorQuotation?     @relation(fields: [quotationId], references: [id])
  vendorId             String
  vendor               Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderDate            DateTime             @default(now())
  expectedDeliveryDate DateTime
  subtotal             Float
  taxAmount            Float                @default(0)
  shippingAmount       Float                @default(0)
  totalAmount          Float
  status               String               @default("DRAFT") // DRAFT, APPROVED, SENT_TO_VENDOR, PARTIALLY_RECEIVED, COMPLETED, CANCELLED
  approvedBy           String?
  approvedAt           DateTime?
  terms                String?
  createdAt            DateTime             @default(now())

  items             PurchaseOrderItem[]
  goodsReceiptNotes GoodsReceiptNote[]

  @@unique([institutionId, poNumber])
  @@index([institutionId])
  @@index([vendorId])
}

model PurchaseOrderItem {
  id               String         @id @default(uuid())
  poId             String
  po               PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId           String?
  item             InventoryItem? @relation(fields: [itemId], references: [id])
  itemName         String
  orderedQuantity  Float
  unitPrice        Float
  taxPercent       Float          @default(0)
  totalPrice       Float
  receivedQuantity Float          @default(0)
  pendingQuantity  Float          @default(0)

  grnItems GoodsReceiptItem[]

  @@index([poId])
}

model GoodsReceiptNote {
  id                   String        @id @default(uuid())
  institutionId        String
  institution          Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  grnNumber            String
  poId                 String
  po                   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  vendorId             String
  vendor               Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  warehouseId          String
  warehouse            Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  challanNumber        String?
  deliveryDate         DateTime      @default(now())
  receivedByEmployeeId String?
  overallStatus        String        @default("ACCEPTED_FULL") // ACCEPTED_FULL, ACCEPTED_PARTIAL, REJECTED
  remarks              String?
  createdAt            DateTime      @default(now())

  items GoodsReceiptItem[]

  @@unique([institutionId, grnNumber])
  @@index([institutionId])
  @@index([poId])
  @@index([warehouseId])
}

model GoodsReceiptItem {
  id                String             @id @default(uuid())
  grnId             String
  grn               GoodsReceiptNote   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItemId          String?
  poItem            PurchaseOrderItem? @relation(fields: [poItemId], references: [id])
  itemId            String?
  item              InventoryItem?     @relation(fields: [itemId], references: [id])
  receivedQuantity  Float
  acceptedQuantity  Float
  rejectedQuantity  Float              @default(0)
  unitCost          Float
  totalAcceptedCost Float
  rejectionReason   String?

  @@index([grnId])
}

// ----------------------------------------------------
// 9. Maintenance & Service Desk
// ----------------------------------------------------

model MaintenanceRequest {
  id                  String      @id @default(uuid())
  institutionId       String
  institution         Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId            String
  campus              Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  ticketNumber        String
  requesterType       String      @default("EMPLOYEE") // STUDENT, EMPLOYEE, FACILITY_STAFF
  requesterEmployeeId String?
  requesterStudentId  String?
  category            String      @default("ELECTRICAL") // ELECTRICAL, PLUMBING, HVAC, IT_EQUIPMENT, FURNITURE, TRANSPORT, HOSTEL, CLEANING, SAFETY, OTHER
  priority            String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  facilityId          String?
  facility            Facility?   @relation(fields: [facilityId], references: [id])
  roomId              String?
  assetId             String?
  title               String
  description         String
  status              String      @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, ON_HOLD, RESOLVED, CLOSED, CANCELLED
  createdAt           DateTime    @default(now())

  workOrder MaintenanceWorkOrder?

  @@unique([institutionId, ticketNumber])
  @@index([institutionId])
  @@index([campusId])
  @@index([status])
}

model MaintenanceWorkOrder {
  id                           String             @id @default(uuid())
  requestId                    String             @unique
  request                      MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  workOrderNumber              String             @unique
  assignedTechnicianEmployeeId String?
  technicianName               String?
  scheduledDate                DateTime           @default(now())
  completedDate                DateTime?
  laborCost                    Float              @default(0)
  partsCost                    Float              @default(0)
  totalCost                    Float              @default(0)
  status                       String             @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  resolutionSummary            String?
  createdAt                    DateTime           @default(now())

  @@index([requestId])
}

// ----------------------------------------------------
// 10. Visitor & Gate Access Management
// ----------------------------------------------------

model VisitorRecord {
  id                 String      @id @default(uuid())
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId           String
  campus             Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  passNumber         String
  visitorName        String
  phone              String
  idProofType        String      @default("NID") // NID, PASSPORT, DRIVING_LICENSE, OFFICE_ID
  idProofNumber      String?
  organization       String?
  purpose            String
  visitingPersonType String      @default("EMPLOYEE") // EMPLOYEE, STUDENT, OFFICE
  hostEmployeeId     String?
  studentId          String?
  gateName           String      @default("Main Gate")
  entryTime          DateTime    @default(now())
  exitTime           DateTime?
  status             String      @default("CHECKED_IN") // EXPECTED, CHECKED_IN, CHECKED_OUT, DENIED
  gateStaffUserId    String?
  createdAt          DateTime    @default(now())

  @@unique([institutionId, passNumber])
  @@index([institutionId])
  @@index([campusId])
  @@index([status])
}

model StudentPickupAuthorization {
  id                   String      @id @default(uuid())
  institutionId        String
  institution          Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId            String
  student              Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorizedPersonName String
  phone                String
  nidNumber            String?
  photoUrl             String?
  relationToStudent    String // Father, Mother, Driver, Uncle, Guardian
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())

  @@index([institutionId])
  @@index([studentId])
}

model VehicleGateLog {
  id                 String      @id @default(uuid())
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId           String
  campus             Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  vehiclePlateNumber String
  driverName         String?
  driverPhone        String?
  vehicleType        String      @default("CAR") // CAR, TRUCK, VAN, BIKE, DELIVERY
  purpose            String
  gateName           String      @default("Main Gate")
  entryTime          DateTime    @default(now())
  exitTime           DateTime?
  recordedBy         String?
  createdAt          DateTime    @default(now())

  @@index([institutionId])
  @@index([campusId])
}

// ----------------------------------------------------
// 11. Facility Booking & Academic Conflict Detection
// ----------------------------------------------------

model FacilityBooking {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String
  campus        Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  bookingNumber String
  facilityId    String?
  facility      Facility?   @relation(fields: [facilityId], references: [id])
  classroomId   String?
  bookingDate   DateTime
  startTime     String // "09:00"
  endTime       String // "12:00"
  purpose       String
  requestedBy   String
  requesterType String      @default("EMPLOYEE") // EMPLOYEE, STUDENT, EXTERNAL
  attendeeCount Int         @default(20)
  status        String      @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, CANCELLED
  approvedBy    String?
  reviewNotes   String?
  createdAt     DateTime    @default(now())

  @@unique([institutionId, bookingNumber])
  @@index([institutionId])
  @@index([campusId])
  @@index([bookingDate])
  @@index([status])
}

// ====================================================
// COMMAND 8: LMS & DIGITAL LEARNING PLATFORM
// ====================================================

model LmsCourse {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId      String
  campus        Campus      @relation(fields: [campusId], references: [id])

  code             String
  title            String
  description      String?
  coverImageUrl    String?
  academicYearId   String?
  sessionId        String?
  classId          String?
  sectionId        String?
  subjectId        String?
  courseOfferingId String?

  primaryTeacherId String
  primaryTeacher   Employee @relation("LmsPrimaryTeacher", fields: [primaryTeacherId], references: [id])
  coTeacherIds     String? // JSON array of Employee IDs
  coordinatorId    String?

  status           String                  @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  syllabus         LmsSyllabus?
  learningOutcomes LmsLearningOutcome[]
  modules          LmsModule[]
  homeworks        LmsHomework[]
  assignments      LmsAssignment[]
  quizzes          LmsQuiz[]
  onlineClasses    LmsOnlineClass[]
  discussions      LmsDiscussion[]
  gradebookItems   LmsGradebookItem[]
  progressRecords  LmsCourseProgress[]
  announcements    LmsCourseAnnouncement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId, campusId])
  @@index([classId, sectionId, subjectId])
  @@index([courseOfferingId])
  @@index([primaryTeacherId])
}

model LmsSyllabus {
  id                   String    @id @default(uuid())
  courseId             String    @unique
  course               LmsCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  overview             String?
  objectives           String?
  learningOutcomesDesc String?
  requiredMaterials    String?
  assessmentBreakdown  String? // JSON or text
  policies             String?
  officeHours          String?
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model LmsLearningOutcome {
  id          String    @id @default(uuid())
  courseId    String
  course      LmsCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code        String // e.g. "CLO1", "LO2"
  description String
  bloomLevel  String? // REMEMBER, UNDERSTAND, APPLY, ANALYZE, EVALUATE, CREATE
  createdAt   DateTime  @default(now())

  @@index([courseId])
}

model LmsModule {
  id                   String      @id @default(uuid())
  courseId             String
  course               LmsCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title                String
  description          String?
  sequenceOrder        Int         @default(1)
  releaseType          String      @default("IMMEDIATE") // IMMEDIATE, SPECIFIC_DATE, PREREQUISITE_MODULE, MANUAL
  releaseDate          DateTime?
  prerequisiteModuleId String?
  isPublished          Boolean     @default(true)
  lessons              LmsLesson[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([courseId, sequenceOrder])
}

model LmsLesson {
  id                       String              @id @default(uuid())
  moduleId                 String
  module                   LmsModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title                    String
  summary                  String?
  content                  String? // Rich text or Markdown
  contentType              String              @default("RICH_TEXT") // RICH_TEXT, PDF, VIDEO_LINK, EXTERNAL_LINK, DOCUMENT, EMBED, FILE
  fileUrl                  String?
  videoUrl                 String?
  estimatedDurationMinutes Int                 @default(30)
  sequenceOrder            Int                 @default(1)
  completionRule           String              @default("MANUAL_CHECK") // MANUAL_CHECK, VIEW_RESOURCE, ASSIGNMENT_SUBMIT, QUIZ_PASS
  status                   String              @default("PUBLISHED") // DRAFT, PUBLISHED
  progresses               LmsLessonProgress[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([moduleId, sequenceOrder])
}

model LmsLessonProgress {
  id             String    @id @default(uuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         LmsLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status         String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessedAt DateTime  @default(now())

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}

model LmsCourseProgress {
  id                       String    @id @default(uuid())
  studentId                String
  student                  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId                 String
  course                   LmsCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedActivitiesCount Int       @default(0)
  totalActivitiesCount     Int       @default(0)
  progressPercentage       Float     @default(0)
  status                   String    @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, COMPLETED, WITHDRAWN
  lastCalculatedAt         DateTime  @default(now())

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model LmsCourseAnnouncement {
  id              String    @id @default(uuid())
  courseId        String
  course          LmsCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  content         String
  targetSectionId String?
  authorName      String
  authorId        String
  isPinned        Boolean   @default(false)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([courseId])
}

model LmsHomework {
  id            String                  @id @default(uuid())
  courseId      String
  course        LmsCourse               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  instructions  String?
  assignedDate  DateTime                @default(now())
  dueDate       DateTime
  attachmentUrl String?
  maxMarks      Float?                  @default(10)
  status        String                  @default("PUBLISHED") // DRAFT, PUBLISHED, CLOSED
  submissions   LmsHomeworkSubmission[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([courseId, dueDate])
}

model LmsHomeworkSubmission {
  id             String      @id @default(uuid())
  homeworkId     String
  homework       LmsHomework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt    DateTime    @default(now())
  contentText    String?
  attachmentUrl  String?
  status         String      @default("SUBMITTED") // SUBMITTED, COMPLETED, LATE
  teacherRemarks String?
  scoreObtained  Float?

  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId])
}

model LmsAssignment {
  id                   String                    @id @default(uuid())
  courseId             String
  course               LmsCourse                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title                String
  instructions         String?
  totalMarks           Float                     @default(100)
  weightPercent        Float                     @default(10)
  startDate            DateTime                  @default(now())
  dueDate              DateTime
  lateDeadline         DateTime?
  lateSubmissionPolicy String                    @default("ALLOWED") // ALLOWED, NOT_ALLOWED, PENALTY_PERCENT
  latePenaltyPercent   Float                     @default(10)
  submissionType       String                    @default("FILE") // TEXT, FILE, MULTIPLE_FILES, LINK, OFFLINE, GROUP
  maxAttempts          Int                       @default(1)
  isLocked             Boolean                   @default(false)
  status               String                    @default("PUBLISHED") // DRAFT, PUBLISHED, CLOSED
  rubricId             String?
  rubric               LmsRubric?                @relation(fields: [rubricId], references: [id])
  submissions          LmsAssignmentSubmission[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([courseId, dueDate])
}

model LmsRubric {
  id            String               @id @default(uuid())
  institutionId String
  institution   Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  totalPoints   Float                @default(100)
  criteria      LmsRubricCriterion[]
  assignments   LmsAssignment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([institutionId])
}

model LmsRubricCriterion {
  id          String           @id @default(uuid())
  rubricId    String
  rubric      LmsRubric        @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  title       String
  description String?
  maxPoints   Float
  levels      LmsRubricLevel[]

  @@index([rubricId])
}

model LmsRubricLevel {
  id          String             @id @default(uuid())
  criterionId String
  criterion   LmsRubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  title       String // e.g. "Excellent", "Good", "Needs Improvement"
  description String?
  points      Float

  @@index([criterionId])
}

model LmsAssignmentSubmission {
  id                 String        @id @default(uuid())
  assignmentId       String
  assignment         LmsAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber      Int           @default(1)
  submittedAt        DateTime      @default(now())
  contentText        String?
  fileUrls           String? // JSON array of strings
  status             String        @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, GRADED, RETURNED_FOR_CORRECTION
  score              Float?
  rubricScoresJson   String? // JSON scoring per criterion
  feedbackText       String?
  gradedByEmployeeId String?
  gradedBy           Employee?     @relation(fields: [gradedByEmployeeId], references: [id])
  gradedAt           DateTime?
  isLate             Boolean       @default(false)
  penaltyDeducted    Float         @default(0)

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId])
  @@index([studentId])
}

model LmsQuestionBank {
  id                   String            @id @default(uuid())
  institutionId        String
  institution          Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subjectId            String?
  courseId             String?
  topic                String?
  learningOutcomeCode  String?
  questionType         String            @default("MCQ_SINGLE") // MCQ_SINGLE, MCQ_MULTIPLE, TRUE_FALSE, FILL_BLANK, SHORT_ANSWER, LONG_ANSWER, ESSAY, NUMERIC, MATCHING, ORDERING, FILE_RESPONSE
  difficulty           String            @default("MEDIUM") // EASY, MEDIUM, HARD
  bloomTaxonomy        String? // REMEMBER, UNDERSTAND, APPLY, ANALYZE, EVALUATE, CREATE
  questionText         String
  explanation          String?
  marks                Float             @default(1)
  optionsJson          String? // JSON array for choices
  correctAnswerJson    String // Secure JSON string of correct answer
  version              Int               @default(1)
  status               String            @default("APPROVED") // DRAFT, UNDER_REVIEW, APPROVED, ARCHIVED
  createdByEmployeeId  String?
  approvedByEmployeeId String?
  quizQuestions        LmsQuizQuestion[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([institutionId, questionType, difficulty])
  @@index([subjectId, topic])
}

model LmsQuiz {
  id                   String            @id @default(uuid())
  courseId             String
  course               LmsCourse         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title                String
  instructions         String?
  openTime             DateTime          @default(now())
  closeTime            DateTime
  durationMinutes      Int               @default(30)
  maxAttempts          Int               @default(1)
  totalMarks           Float             @default(20)
  passMark             Float             @default(8)
  shuffleQuestions     Boolean           @default(true)
  shuffleOptions       Boolean           @default(true)
  showResultsPolicy    String            @default("AFTER_DEADLINE") // IMMEDIATELY, AFTER_DEADLINE, AFTER_TEACHER_REVIEW, NEVER_ANSWERS
  negativeMarkingRatio Float             @default(0) // e.g. 0.25 (25% deduction)
  status               String            @default("PUBLISHED") // DRAFT, PUBLISHED, CLOSED
  questions            LmsQuizQuestion[]
  attempts             LmsQuizAttempt[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([courseId, closeTime])
}

model LmsQuizQuestion {
  id                String            @id @default(uuid())
  quizId            String
  quiz              LmsQuiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionBankId    String?
  questionBank      LmsQuestionBank?  @relation(fields: [questionBankId], references: [id])
  questionText      String
  questionType      String            @default("MCQ_SINGLE")
  optionsJson       String?
  correctAnswerJson String // Stored for immutable snapshot
  marks             Float             @default(1)
  negativeMarks     Float             @default(0)
  sequenceOrder     Int               @default(1)
  responses         LmsQuizResponse[]

  @@index([quizId, sequenceOrder])
}

model LmsQuizAttempt {
  id             String            @id @default(uuid())
  quizId         String
  quiz           LmsQuiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber  Int               @default(1)
  startedAt      DateTime          @default(now())
  serverExpiryAt DateTime
  submittedAt    DateTime?
  status         String            @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, EXPIRED, GRADED
  scoreObtained  Float             @default(0)
  totalMarks     Float             @default(0)
  percentage     Float             @default(0)
  passed         Boolean           @default(false)
  responses      LmsQuizResponse[]
  createdAt      DateTime          @default(now())

  @@unique([quizId, studentId, attemptNumber])
  @@index([quizId])
  @@index([studentId])
}

model LmsQuizResponse {
  id                 String          @id @default(uuid())
  attemptId          String
  attempt            LmsQuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId         String
  question           LmsQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswerJson  String? // JSON student response
  isAutoGraded       Boolean         @default(false)
  scoreAwarded       Float           @default(0)
  teacherComments    String?
  gradedByEmployeeId String?

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model LmsOnlineClass {
  id                String                     @id @default(uuid())
  courseId          String
  course            LmsCourse                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  topic             String?
  teacherEmployeeId String
  teacher           Employee                   @relation("OnlineClassTeacher", fields: [teacherEmployeeId], references: [id])
  classDate         DateTime
  startTime         String // "10:00"
  endTime           String // "11:30"
  meetingProvider   String                     @default("GOOGLE_MEET") // ZOOM, GOOGLE_MEET, MICROSOFT_TEAMS, CUSTOM_URL
  meetingUrl        String
  meetingPasscode   String?
  recordingUrl      String?
  status            String                     @default("SCHEDULED") // SCHEDULED, LIVE, COMPLETED, CANCELLED
  attendanceRecords LmsOnlineClassAttendance[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([courseId, classDate])
}

model LmsOnlineClassAttendance {
  id               String         @id @default(uuid())
  onlineClassId    String
  onlineClass      LmsOnlineClass @relation(fields: [onlineClassId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt         DateTime?
  leftAt           DateTime?
  durationMinutes  Int            @default(0)
  attendanceStatus String         @default("PRESENT") // PRESENT, LATE, ABSENT
  source           String         @default("LMS_JOIN_EVENT") // MANUAL, LMS_JOIN_EVENT, PROVIDER_API
  createdAt        DateTime       @default(now())

  @@unique([onlineClassId, studentId])
  @@index([onlineClassId])
  @@index([studentId])
}

model LmsDiscussion {
  id              String              @id @default(uuid())
  courseId        String
  course          LmsCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  createdByUserId String
  authorName      String
  authorRole      String
  isPinned        Boolean             @default(false)
  isLocked        Boolean             @default(false)
  status          String              @default("ACTIVE") // ACTIVE, LOCKED, HIDDEN
  postsCount      Int                 @default(0)
  posts           LmsDiscussionPost[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([courseId])
}

model LmsDiscussionPost {
  id           String              @id @default(uuid())
  discussionId String
  discussion   LmsDiscussion       @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorUserId String
  authorName   String
  authorRole   String
  content      String
  parentPostId String?
  parentPost   LmsDiscussionPost?  @relation("DiscussionPostReplies", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies      LmsDiscussionPost[] @relation("DiscussionPostReplies")
  isHidden     Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([discussionId])
  @@index([parentPostId])
}

model LmsGradebookItem {
  id                    String              @id @default(uuid())
  courseId              String
  course                LmsCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  itemType              String // HOMEWORK, ASSIGNMENT, QUIZ, LAB, CUSTOM
  referenceId           String? // e.g. assignmentId or quizId
  title                 String
  maxScore              Float               @default(100)
  weightPercent         Float               @default(10)
  assessmentComponentId String? // Optional mapping to Command 4 AssessmentComponent
  isPublished           Boolean             @default(true)
  scores                LmsGradebookScore[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([courseId])
}

model LmsGradebookScore {
  id                     String           @id @default(uuid())
  gradebookItemId        String
  gradebookItem          LmsGradebookItem @relation(fields: [gradebookItemId], references: [id], onDelete: Cascade)
  studentId              String
  student                Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scoreObtained          Float            @default(0)
  finalWeightedScore     Float            @default(0)
  isOverridden           Boolean          @default(false)
  overrideReason         String?
  overriddenByEmployeeId String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([gradebookItemId, studentId])
  @@index([gradebookItemId])
  @@index([studentId])
}

model LmsLearningActivityLog {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId      String
  activityType  String // LESSON_VIEWED, ASSIGNMENT_SUBMITTED, QUIZ_ATTEMPTED, CLASS_JOINED
  detailsJson   String?
  timestamp     DateTime    @default(now())

  @@index([institutionId, studentId])
  @@index([courseId, activityType])
}

// ============================================================================
// COMMAND 9 — ENTERPRISE REPORTING, CUSTOM REPORT BUILDER & REGULATORY COMPLIANCE
// ============================================================================

// ----------------------------------------------------
// 1. Governed Dataset Registry & Field Catalog
// ----------------------------------------------------

model ReportingDataset {
  id                 String             @id @default(uuid())
  code               String             @unique // STUDENTS, ADMISSIONS, ENROLLMENTS, ATTENDANCE, EXAM_RESULTS, LMS_PROGRESS, FEES, RECEIVABLES, PAYMENTS, GENERAL_LEDGER, EMPLOYEES, HR_ATTENDANCE, LEAVE, PAYROLL, LIBRARY, HOSTEL, TRANSPORT, INVENTORY, ASSETS, PROCUREMENT, RESEARCH_PROJECTS, PLATFORM_TENANTS, PLATFORM_USAGE
  name               String
  description        String?
  category           String             @default("ACADEMIC") // ACADEMIC, FINANCE, HR, FACILITIES, LMS, GOVERNANCE, PLATFORM
  requiredPermission String?
  isPlatformDataset  Boolean            @default(false)
  isActive           Boolean            @default(true)
  fields             ReportingField[]
  reports            ReportDefinition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportingField {
  id                 String           @id @default(uuid())
  datasetId          String
  dataset            ReportingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  fieldKey           String // studentIdNumber, firstName, rollNumber, grossSalary, etc.
  label              String
  dataType           String           @default("STRING") // STRING, NUMBER, DECIMAL, DATE, DATETIME, BOOLEAN, ENUM, CURRENCY, PERCENTAGE
  sourceModel        String // Student, Enrollment, Invoice, etc.
  sourceField        String // id, name, totalAmount, etc.
  isSortable         Boolean          @default(true)
  isFilterable       Boolean          @default(true)
  isGroupable        Boolean          @default(true)
  allowAggregation   Boolean          @default(false)
  classification     String           @default("INTERNAL") // PUBLIC, INTERNAL, CONFIDENTIAL, RESTRICTED
  piiMaskingType     String           @default("NONE") // NONE, PHONE, EMAIL, NID, BANK_ACCOUNT
  requiredPermission String? // Specific permission required to query this field (e.g., PAYROLL:VIEW for salary)
  isExportable       Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([datasetId, fieldKey])
  @@index([datasetId])
}

// ----------------------------------------------------
// 2. Custom Report Definitions & Sub-components
// ----------------------------------------------------

model ReportDefinition {
  id                   String           @id @default(uuid())
  institutionId        String?
  institution          Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusId             String?
  campus               Campus?          @relation(fields: [campusId], references: [id])
  datasetId            String
  dataset              ReportingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetCode          String // Cached dataset code
  code                 String?
  name                 String
  description          String?
  ownerUserId          String
  visibility           String           @default("PRIVATE") // PRIVATE, ROLE_SHARED, DEPARTMENT_SHARED, CAMPUS_SHARED, INSTITUTION_SHARED
  status               String           @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  version              Int              @default(1)
  isStandard           Boolean          @default(false)
  isFavorite           Boolean          @default(false)
  defaultSortField     String?
  defaultSortDirection String           @default("ASC")

  columns          ReportColumn[]
  filters          ReportFilter[]
  sorts            ReportSort[]
  groups           ReportGroup[]
  calculatedFields ReportCalculatedField[]
  executions       ReportExecution[]
  snapshots        ReportSnapshot[]
  exports          ReportExport[]
  schedules        ReportSchedule[]
  dashboardWidgets DashboardWidget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([datasetId])
  @@index([ownerUserId])
}

model ReportColumn {
  id                 String           @id @default(uuid())
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  fieldKey           String
  displayLabel       String
  sequenceOrder      Int              @default(1)
  columnWidth        Int?
  formattingJson     String? // e.g. {"format": "CURRENCY", "precision": 2}
  aggregateType      String? // COUNT, SUM, AVG, MIN, MAX, DISTINCT_COUNT

  @@index([reportDefinitionId])
}

model ReportFilter {
  id                 String           @id @default(uuid())
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  fieldKey           String
  operator           String // EQUALS, NOT_EQUALS, CONTAINS, STARTS_WITH, GREATER_THAN, LESS_THAN, BETWEEN, IN, IS_NULL, IS_NOT_NULL
  valueJson          String // JSON-encoded value (string, number, array)
  sequenceOrder      Int              @default(1)
  isLocked           Boolean          @default(false)

  @@index([reportDefinitionId])
}

model ReportSort {
  id                 String           @id @default(uuid())
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  fieldKey           String
  direction          String           @default("ASC") // ASC, DESC
  priority           Int              @default(1)

  @@index([reportDefinitionId])
}

model ReportGroup {
  id                 String           @id @default(uuid())
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  fieldKey           String
  sequenceOrder      Int              @default(1)

  @@index([reportDefinitionId])
}

model ReportCalculatedField {
  id                 String           @id @default(uuid())
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  fieldKey           String
  label              String
  formulaExpression  String // Sandboxed expression e.g. "attendance_rate", "collection_rate", "net_balance"
  dataType           String           @default("DECIMAL")

  @@index([reportDefinitionId])
}

model ReportExecution {
  id                 String            @id @default(uuid())
  institutionId      String
  institution        Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  reportDefinitionId String?
  reportDefinition   ReportDefinition? @relation(fields: [reportDefinitionId], references: [id], onDelete: SetNull)
  datasetCode        String
  executedByUserId   String
  status             String            @default("COMPLETED") // QUEUED, RUNNING, COMPLETED, FAILED
  rowCount           Int               @default(0)
  durationMs         Int               @default(0)
  filterParamsJson   String?
  errorDetails       String?
  executedAt         DateTime          @default(now())

  @@index([institutionId])
  @@index([reportDefinitionId])
  @@index([executedByUserId])
}

model ReportSnapshot {
  id                 String            @id @default(uuid())
  institutionId      String
  institution        Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  reportDefinitionId String?
  reportDefinition   ReportDefinition? @relation(fields: [reportDefinitionId], references: [id], onDelete: SetNull)
  datasetCode        String
  definitionVersion  Int               @default(1)
  parametersJson     String?
  rowCount           Int               @default(0)
  dataHash           String // SHA-256 integrity hash
  snapshotDataJson   String // Serialized tabular result snapshot
  generatedByUserId  String
  generatedAt        DateTime          @default(now())

  @@index([institutionId])
  @@index([reportDefinitionId])
}

model ReportExport {
  id                    String            @id @default(uuid())
  institutionId         String
  institution           Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  reportDefinitionId    String?
  reportDefinition      ReportDefinition? @relation(fields: [reportDefinitionId], references: [id], onDelete: SetNull)
  exportFormat          String // CSV, XLSX, PDF
  sensitiveDataIncluded Boolean           @default(false)
  rowCount              Int               @default(0)
  fileSize              Int?
  exportedByUserId      String
  exportedAt            DateTime          @default(now())

  @@index([institutionId])
  @@index([reportDefinitionId])
}

// ----------------------------------------------------
// 3. Dashboard Builder & Dynamic Widgets
// ----------------------------------------------------

model DashboardDefinition {
  id              String            @id @default(uuid())
  institutionId   String?
  institution     Institution?      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  code            String            @unique
  title           String
  description     String?
  category        String            @default("EXECUTIVE") // EXECUTIVE, PRINCIPAL, VC, FINANCE, HR, ACADEMIC, PLATFORM
  isStandard      Boolean           @default(false)
  layoutJson      String? // Grid layout configuration
  createdByUserId String
  widgets         DashboardWidget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
}

model DashboardWidget {
  id                 String              @id @default(uuid())
  dashboardId        String
  dashboard          DashboardDefinition @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  title              String
  widgetType         String // KPI_CARD, NUMBER, TABLE, BAR_CHART, LINE_CHART, DONUT_CHART, TREND
  datasetCode        String
  reportDefinitionId String?
  reportDefinition   ReportDefinition?   @relation(fields: [reportDefinitionId], references: [id], onDelete: SetNull)
  queryConfigJson    String // Metrics, dimensions, filters
  gridPositionJson   String? // {x, y, w, h}
  refreshIntervalSec Int                 @default(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dashboardId])
}

model ReportSchedule {
  id                 String           @id @default(uuid())
  institutionId      String
  institution        Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  scheduleFrequency  String // DAILY, WEEKLY, MONTHLY, TERM_END
  recipientsJson     String // Array of email/user targets
  outputFormat       String           @default("XLSX") // XLSX, CSV, PDF
  status             String           @default("ACTIVE") // ACTIVE, PAUSED, EXPIRED
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  deliveryStatus     String           @default("REPORT_SCHEDULING_ENGINE_REAL; EMAIL_DELIVERY_PROVIDER_PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([reportDefinitionId])
}

// ----------------------------------------------------
// 4. Regulatory Agency & Versioned Compliance Templates
// ----------------------------------------------------

model RegulatoryAgency {
  id           String               @id @default(uuid())
  code         String               @unique // BANBEIS, DSHE, EDUCATION_BOARD, BMEB_MADRASHA, BTEB, UGC, MOE
  name         String
  shortName    String
  description  String?
  jurisdiction String               @default("BANGLADESH")
  websiteUrl   String?
  isActive     Boolean              @default(true)
  templates    RegulatoryTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegulatoryTemplate {
  id              String           @id @default(uuid())
  agencyId        String
  agency          RegulatoryAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyCode      String
  templateCode    String // BANBEIS_ANNUAL_CENSUS, DSHE_ENROLLMENT_RETURN, UGC_ANNUAL_REPORT, BTEB_TRADE_RETURN, MADRASHA_EXAM_RETURN
  title           String
  version         Int              @default(1)
  institutionType String? // SCHOOL, COLLEGE, MADRASHA, UNIVERSITY, POLYTECHNIC, VOCATIONAL
  effectiveFrom   DateTime         @default(now())
  effectiveUntil  DateTime?
  status          String           @default("ACTIVE") // DRAFT, ACTIVE, SUPERSEDED, ARCHIVED
  outputFormat    String           @default("XLSX") // XLSX, CSV, PDF
  isStandard      Boolean          @default(true)

  fields     RegulatoryTemplateField[]
  mappings   RegulatoryFieldMapping[]
  reportRuns RegulatoryReportRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateCode, version])
  @@index([agencyId])
}

model RegulatoryTemplateField {
  id                 String                   @id @default(uuid())
  templateId         String
  template           RegulatoryTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldCode          String // e.g. EIIN_NO, TOTAL_MALE_STUDENTS, SANITATION_FACILITIES
  label              String
  dataType           String                   @default("STRING")
  isRequired         Boolean                  @default(true)
  validationRuleJson String? // Min, max, regex, allowed values
  sectionName        String? // Form section
  sequenceOrder      Int                      @default(1)
  mappings           RegulatoryFieldMapping[]

  @@unique([templateId, fieldCode])
  @@index([templateId])
}

model RegulatoryFieldMapping {
  id                  String                  @id @default(uuid())
  templateId          String
  template            RegulatoryTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateFieldId     String
  templateField       RegulatoryTemplateField @relation(fields: [templateFieldId], references: [id], onDelete: Cascade)
  sourceDatasetCode   String // STUDENTS, EMPLOYEES, EXAM_RESULTS, etc.
  sourceFieldKey      String // studentIdNumber, gender, etc.
  transformRule       String                  @default("DIRECT") // DIRECT, DATE_FORMAT, GENDER_CODE, RELIGION_CODE, STATUS_MAP, FORMULA
  transformConfigJson String?

  @@unique([templateId, templateFieldId])
  @@index([templateId])
}

model RegulatoryReportRun {
  id                String             @id @default(uuid())
  institutionId     String
  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  templateId        String
  template          RegulatoryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  academicYearId    String?
  sessionId         String?
  reportingPeriod   String // "2025-2026", "Spring 2026", etc.
  status            String             @default("DRAFT") // DRAFT, VALIDATING, VALIDATION_FAILED, READY, APPROVED, EXPORTED, SUPERSEDED
  preparerUserId    String
  reviewerUserId    String?
  approverUserId    String?
  approvedAt        DateTime?
  snapshotDataJson  String? // Immutable snapshot of compiled return
  snapshotHash      String?
  exportedAt        DateTime?
  exportFormat      String?
  integrationStatus String             @default("REGULATORY_DATA_VALIDATION_REAL; REGULATORY_EXPORT_REAL; EXTERNAL_GOVERNMENT_SUBMISSION_API_PENDING")

  validationIssues RegulatoryValidationIssue[]
  submissionRecord RegulatorySubmissionRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([templateId])
}

model RegulatoryValidationIssue {
  id               String              @id @default(uuid())
  reportRunId      String
  reportRun        RegulatoryReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  severity         String              @default("ERROR") // ERROR, WARNING, INFO
  fieldCode        String
  sourceRecordId   String?
  sourceRecordType String? // Student, Employee, Subject, etc.
  message          String
  resolutionLink   String?

  createdAt DateTime @default(now())

  @@index([reportRunId])
}

model RegulatorySubmissionRecord {
  id                    String              @id @default(uuid())
  reportRunId           String              @unique
  reportRun             RegulatoryReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  submittedDate         DateTime            @default(now())
  submissionReference   String?
  acknowledgementNumber String?
  submittedByUserId     String
  submissionDocumentUrl String?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

// ----------------------------------------------------
// 5. Enterprise Data Quality Rules & Issues
// ----------------------------------------------------

model DataQualityRule {
  id             String             @id @default(uuid())
  institutionId  String?
  institution    Institution?       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  datasetCode    String // STUDENTS, EMPLOYEES, ADMISSIONS, etc.
  ruleCode       String             @unique
  title          String
  severity       String             @default("ERROR") // ERROR, WARNING
  checkType      String // MISSING_REQUIRED, DUPLICATE, INVALID_RELATION, OUT_OF_RANGE
  ruleConfigJson String // JSON configuration of the check
  isActive       Boolean            @default(true)
  issues         DataQualityIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
}

model DataQualityIssue {
  id            String          @id @default(uuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  datasetCode   String
  ruleId        String
  rule          DataQualityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  recordId      String
  recordTitle   String
  severity      String          @default("ERROR")
  details       String
  detectedAt    DateTime        @default(now())
  status        String          @default("OPEN") // OPEN, RESOLVED, IGNORED

  @@index([institutionId])
  @@index([ruleId])
}
